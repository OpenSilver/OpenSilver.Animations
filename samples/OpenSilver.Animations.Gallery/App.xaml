<Application x:Class="OpenSilver.Animations.Gallery.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="http://opensilver.net/animations"
             xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls">

    <Application.Resources>

        <!-- The settings of every animation in the app, read once at startup. -->
        <anim:AnimationSettings x:Key="AnimationSettings" />

        <!-- Colors -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F5FA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="StageBrush" Color="#F7F8FC" />
        <SolidColorBrush x:Key="LineBrush" Color="#E4E6EF" />
        <SolidColorBrush x:Key="StageLineBrush" Color="#E9EBF3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5B5BD6" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#4646B8" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#ECECFD" />
        <SolidColorBrush x:Key="TextBrush" Color="#1C1E2B" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#545970" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8FA3" />
        <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#1F2133" />
        <SolidColorBrush x:Key="CodeTextBrush" Color="#E4E5F1" />
        <SolidColorBrush x:Key="TipBackgroundBrush" Color="#FFF8E7" />
        <SolidColorBrush x:Key="TipLineBrush" Color="#F3DC9E" />
        <SolidColorBrush x:Key="DarkPanelBrush" Color="#23263A" />

        <FontFamily x:Key="UiFont">Segoe UI, system-ui, -apple-system, Helvetica, Arial, sans-serif</FontFamily>
        <FontFamily x:Key="CodeFont">Consolas, Menlo, monospace</FontFamily>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <controls:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
        <controls:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />

        <!-- Text -->
        <Style x:Key="OverlineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="ChapterTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Responsive Mobile=26, Tablet=32}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="IntroText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Responsive Mobile=15, Tablet=16}" />
            <Setter Property="LineHeight" Value="{Responsive Mobile=23, Tablet=25}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="HeadingText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CodeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
            <Setter Property="FontSize" Value="{Responsive Mobile=12, Tablet=13}" />
            <Setter Property="LineHeight" Value="{Responsive Mobile=18, Tablet=20}" />
            <Setter Property="Foreground" Value="{StaticResource CodeTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Boxes -->
        <Style x:Key="ChapterRoot" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="920" />
            <Setter Property="Margin" Value="{Responsive Mobile='16,20,16,32', Tablet='40,36,40,48'}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="TipBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TipBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TipLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="{Responsive Mobile='16,14', Tablet='20,16'}" />
            <Setter Property="Margin" Value="0,8,0,24" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <Border x:Name="HoverOverlay" Background="#12000000" CornerRadius="8" Opacity="0" />
                            <Border x:Name="PressedOverlay" Background="#22000000" CornerRadius="8" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#D9DCE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="9" />
        </Style>

        <Style x:Key="ChapterButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <!-- A switch with a label, used for the toolbar options -->
        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="12" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverOverlay" Background="#0A000000" CornerRadius="8" Opacity="0" />
                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                <Grid Width="30" Height="18" VerticalAlignment="Center">
                                    <Border Background="#C9CCD8" CornerRadius="9" />
                                    <Border x:Name="TrackOn" Background="{StaticResource AccentBrush}" CornerRadius="9" Opacity="0" />
                                    <Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="KnobShift" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The header of a section that expands: a chevron that points right, and down once expanded -->
        <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverOverlay" Background="#0A000000" CornerRadius="6" Opacity="0" />
                            <StackPanel Orientation="Horizontal" Margin="6,5,8,5">
                                <Path Width="10" Height="10" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                      Data="M 3.5,1.5 L 7,5 L 3.5,8.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ChevronTurn" />
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The area of a demo where the live example plays -->
        <Style x:Key="DemoStage" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StageBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StageLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="{Responsive Mobile=12, Tablet=20}" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!-- A demo: a title, a sentence, the live example, its XAML and what should happen -->
        <Style TargetType="controls:DemoCard">
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="Padding" Value="{Responsive Mobile=16, Tablet=24}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:DemoCard">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource HeadingText}" />
                                <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                                <Border Style="{StaticResource DemoStage}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Border>
                                <Border Background="{StaticResource CodeBackgroundBrush}" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"
                                        Visibility="{Binding Xaml, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NonEmptyToVisibility}}">
                                    <TextBlock Text="{TemplateBinding Xaml}" Style="{StaticResource CodeText}" />
                                </Border>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding Expectations, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NonEmptyToVisibility}}">
                                    <ToggleButton x:Name="ExpectationsToggle" Content="What should happen" Style="{StaticResource ExpanderToggle}" HorizontalAlignment="Left" Margin="-6,0,0,0" />
                                    <TextBlock Text="{TemplateBinding Expectations}" Style="{StaticResource BodyText}" FontSize="13" Margin="18,4,0,0"
                                               Visibility="{Binding IsChecked, ElementName=ExpectationsToggle, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tab header: the selected one is shown by an underline below the tabs -->
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Padding" Value="{Responsive Mobile='8,10', Tablet='14,10'}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DCE7" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- The label of a slider, in an Auto column -->
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="{Responsive Mobile=88, Tablet=120}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </Application.Resources>
</Application>
