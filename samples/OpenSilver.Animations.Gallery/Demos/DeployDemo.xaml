<UserControl x:Class="OpenSilver.Animations.Gallery.Demos.DeployDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="http://opensilver.net/animations"
             xmlns:demos="clr-namespace:OpenSilver.Animations.Gallery.Demos">

    <!-- A button that grows into a card, which changes shape at each step of a pretend deployment.
         The view model only holds the state, and each click changes it: every animation is an anim:
         attribute below, and the states are shown with bindings and triggers. -->
    <UserControl.DataContext>
        <demos:DeployDemoViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#0C0C14" />
        <SolidColorBrush x:Key="CardTextBrush" Color="#F4F4F8" />
        <SolidColorBrush x:Key="CardMutedBrush" Color="#8E90A6" />
        <SolidColorBrush x:Key="CardFaintBrush" Color="#5E6078" />
        <SolidColorBrush x:Key="CardSurfaceBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="MintBrush" Color="#34D399" />

        <LinearGradientBrush x:Key="AppIconBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B7CFF" Offset="0" />
            <GradientStop Color="#F472B6" Offset="1" />
        </LinearGradientBrush>

        <!-- The content of each step comes into focus while the card springs to its new size. The
             step itself appears and disappears with None, so that the timing of that spring comes
             from the card's MoveAndResize. -->
        <anim:Custom x:Key="StepAppear" Blur="8" Zoom="0.96" Duration="0.4s" StartAfter="0.12s" Easing="StrongEaseOut" />
        <anim:Custom x:Key="TabAppear" Blur="6" OffsetY="6" Duration="0.35s" StartAfter="0.05s" Easing="StrongEaseOut" />

        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CardTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Overline" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CardFaintBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="140" />
        </Style>

        <!-- The big button that invites the click -->
        <Style x:Key="LaunchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="36" Padding="10,10,28,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C5CFF" Offset="0" />
                                    <GradientStop Color="#5B5BD6" Offset="0.55" />
                                    <GradientStop Color="#B44FD0" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#5B5BD6" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A round button on the card, like the close button -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Width="30" Height="30" CornerRadius="15" Background="#1AFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The main action of a step: white, or dim for Cancel -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource CardBrush}" />
            <Setter Property="Background" Value="#E9E9F1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="14" Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="Shine" CornerRadius="14" Background="#26FFFFFF" Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArrowIcon" TargetType="Path">
            <Setter Property="Data" Value="M0,5 L11,5 M6.5,0.5 L11,5 L6.5,9.5" />
            <Setter Property="Stroke" Value="{StaticResource CardBrush}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,1,0,0" />
        </Style>

        <Style x:Key="CloseIcon" TargetType="Path">
            <Setter Property="Data" Value="M0,0 L9,9 M9,0 L0,9" />
            <Setter Property="Stroke" Value="{StaticResource CardTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <!-- A list without a frame or a scroll bar -->
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="OneRow">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <!-- A segment of the environment picker: its pill, in the environment's color, glides to the
             selected one and changes color on the way. It is also the chip that travels to the next
             steps, which have a Magic move with the same id. -->
        <Style x:Key="SegmentItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Pill" Background="{Binding Accent}" CornerRadius="10" Visibility="Collapsed"
                                    anim:Animate.MagicMoveId="TargetChip" anim:Animate.MagicMoveSettings="{anim:MagicMove Duration=0.5s, Easing=Bouncy}" />
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A commit: a highlight follows the mouse from row to row, and the selection glides to the
             picked commit, where a check pops in. The avatar of the picked one gets a Magic move:
             it travels to the next step. -->
        <Style x:Key="CommitItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="#0FFFFFFF" CornerRadius="12" Visibility="Collapsed"
                                    anim:Animate.MagicMoveId="RowHover" anim:Animate.MagicMoveSettings="{anim:MagicMove Travel=Behind, Duration=0.25s, Easing=Smooth}"
                                    anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade" />
                            <Border x:Name="Picked" Background="#17FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="12" Visibility="Collapsed"
                                    anim:Animate.MagicMoveId="PickedCommit" anim:Animate.MagicMoveSettings="{anim:MagicMove Travel=Behind}"
                                    anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade" />
                            <Grid Margin="10,8,44,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Avatar" Width="30" Height="30" CornerRadius="15" Background="{Binding Color}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold" Foreground="#0C0C14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource CardText}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="Check" Width="20" Height="20" CornerRadius="10" Background="{StaticResource MintBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"
                                    anim:Animate.Appear="Pop" anim:Animate.Disappear="{anim:Zoom To=0.5, Duration=0.15s}">
                                <Path Data="M1,5 L4,8 L10,1.5" Stroke="{StaticResource CardBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Picked" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Avatar" Property="anim:Animate.MagicMoveId" Value="CommitAvatar" />
                                <Setter TargetName="Avatar" Property="anim:Animate.MagicMoveSettings" Value="{anim:MagicMove Duration=0.55s, Easing=Smooth}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A check of the release: the same highlight, and a Logs badge that slides in -->
        <Style x:Key="CheckItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="#0FFFFFFF" CornerRadius="12" Visibility="Collapsed"
                                    anim:Animate.MagicMoveId="RowHover" anim:Animate.MagicMoveSettings="{anim:MagicMove Travel=Behind, Duration=0.25s, Easing=Smooth}"
                                    anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade" />
                            <Grid Margin="10,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter />
                                <Border x:Name="Logs" Grid.Column="1" Background="#1FFFFFFF" CornerRadius="6" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        anim:Animate.Appear="{anim:Slide From=Right, Distance=Short}" anim:Animate.Disappear="{anim:Fade Duration=0.15s}">
                                    <TextBlock Text="Logs ↗" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CardTextBrush}" />
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Logs" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tab at the bottom of the live card: the white pill glides to the clicked tab -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Pill" Background="{StaticResource CardTextBrush}" CornerRadius="10" Visibility="Collapsed"
                                    anim:Animate.MagicMoveId="LiveTab" anim:Animate.MagicMoveSettings="{anim:MagicMove Travel=Behind}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource CardBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A period of the traffic chart: a small white pill that bounces to the picked one -->
        <Style x:Key="RangeItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource CardMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" MinWidth="40">
                            <Border x:Name="Pill" Background="{StaticResource CardTextBrush}" CornerRadius="7" Visibility="Collapsed"
                                    anim:Animate.MagicMoveId="RangePill" anim:Animate.MagicMoveSettings="{anim:MagicMove Travel=Behind, Duration=0.45s, Easing=Bouncy}" />
                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="8,4" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource CardBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A bar of the traffic chart. A column highlight follows the mouse, and the bar's value
             slides up above it. -->
        <Style x:Key="BarItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="#14FFFFFF" CornerRadius="8" Visibility="Collapsed"
                                    anim:Animate.MagicMoveId="BarHover" anim:Animate.MagicMoveSettings="{anim:MagicMove Travel=Behind, Duration=0.2s, Easing=Smooth}"
                                    anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade" />
                            <StackPanel VerticalAlignment="Bottom" Margin="3,0,3,3">
                                <TextBlock x:Name="Value" Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CardTextBrush}"
                                           TextAlignment="Center" Margin="-14,0,-14,4" Visibility="Collapsed"
                                           anim:Animate.Appear="{anim:Slide From=Bottom, Distance=Short, Duration=0.25s}" anim:Animate.Disappear="{anim:Fade Duration=0.1s}" />
                                <Border Height="{Binding Height}" CornerRadius="4" Background="{Binding Color}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Value" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource CardText}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,1" />
        </Style>

        <!-- The environment, as a chip in its color: the selected segment's pill travels into it -->
        <Style x:Key="TargetChip" TargetType="Border">
            <Setter Property="Background" Value="{Binding Target.Accent}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2,8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="anim:Animate.MagicMoveId" Value="TargetChip" />
            <Setter Property="anim:Animate.MagicMoveSettings" Value="{anim:MagicMove Duration=0.55s, Easing=Overshoot}" />
        </Style>

        <Style x:Key="CommitAvatar" TargetType="Border">
            <Setter Property="Background" Value="{Binding Commit.Color}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="anim:Animate.MagicMoveId" Value="CommitAvatar" />
            <Setter Property="anim:Animate.MagicMoveSettings" Value="{anim:MagicMove Duration=0.55s, Easing=Overshoot}" />
        </Style>

        <!-- Confetti, with no timer: each piece is where it lands, below the stage, out of sight. Its
             Appear starts it at the center, behind the card, and bursts it out; the Appear of the
             piece inside starts it higher up and lets it fall, faster and faster. -->
        <Style x:Key="Confetto" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <Style x:Key="ConfettoPiece" TargetType="Border">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <Style x:Key="FactNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Responsive Mobile=24, Tablet=28}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FactName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="Stage" CornerRadius="20" BorderBrush="#E4E6EF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EEF0FF" Offset="0" />
                <GradientStop Color="#F8EEFB" Offset="0.55" />
                <GradientStop Color="#FFF3EA" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid ClipToBounds="True">
            <!-- Soft lights behind the card. A large negative margin on the far side keeps them from
                 making the stage taller: its height follows the card. -->
            <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-170,0,-2000" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#557C5CFF" Offset="0" />
                        <GradientStop Color="#007C5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,-2000,-160,-200" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#55F472B6" Offset="0" />
                        <GradientStop Color="#00F472B6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,40,-2000" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4038BDF8" Offset="0" />
                        <GradientStop Color="#0038BDF8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel Margin="{Responsive Mobile='14,26,14,20', Tablet='24,40,24,24'}">
                <Grid x:Name="CardArea">

                    <!-- Idle: the button, and a hint that types itself below it -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="LaunchIntro" HorizontalAlignment="Center"
                                anim:Animate.Appear="{anim:Pop StartAfter=0.45s, Bounciness=0.6}">
                            <Button x:Name="TryButton" Style="{StaticResource LaunchButton}" Command="{Binding Open}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibility}}"
                                    anim:Animate.MagicMoveId="Card" anim:Animate.MagicMoveSettings="{anim:MagicMove Travel=Above, Duration=0.6s}"
                                    anim:Animate.Hover="{anim:Grow Zoom=1.04, Easing=Bouncy}" anim:Animate.Press="Shrink">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="50" Height="50" CornerRadius="25" Background="White">
                                        <Path Data="M0,0 L11,7 L0,14 Z" Fill="#5B5BD6" StrokeLineJoin="Round" Stroke="#5B5BD6" StrokeThickness="2"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Try the live demo" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="A small deploy app, animated in pure XAML" FontSize="12.5" Foreground="#E3DEFF" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Border>
                        <TextBlock x:Name="Hint" Text="Click it, then click everything." FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,22,0,0"
                                   Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibility}}"
                                   anim:Animate.Appear="{anim:Typewriter StartAfter=1.1s, BlinkFirst=0.4s, OthersDuration=0.6s, Easing=StrongEaseInOut}"
                                   anim:Animate.Disappear="{anim:Fade Duration=0.15s, OthersDuration=0.6s, Easing=StrongEaseInOut}" />
                    </StackPanel>

                    <!-- With MoveAndResize=None, the confetti never give their timing to the card -->
                    <Canvas x:Name="Confetti" Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding IsLive, Converter={StaticResource BooleanToVisibility}}" anim:Animate.MoveAndResize="None">
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-320" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=320, OffsetY=40, Zoom=0.3, Rotate=-160, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.1s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#34D399" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-600, Rotate=420, Duration=1.7s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-260" Canvas.Top="550"
                                anim:Animate.Appear="{anim:Custom OffsetX=260, OffsetY=150, Zoom=0.3, Rotate=140, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.12s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#8B7CFF" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-700, Rotate=-380, Duration=1.9s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-210" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=210, OffsetY=-30, Zoom=0.3, Rotate=-120, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.1s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#F472B6" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-530, Rotate=300, Duration=1.5s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-170" Canvas.Top="550"
                                anim:Animate.Appear="{anim:Custom OffsetX=170, OffsetY=190, Zoom=0.3, Rotate=170, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.14s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#FBBF24" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-740, Rotate=-500, Duration=2s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-300" Canvas.Top="570"
                                anim:Animate.Appear="{anim:Custom OffsetX=300, OffsetY=-90, Zoom=0.3, Rotate=-140, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.11s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#38BDF8" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-480, Rotate=260, Duration=1.4s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-240" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=240, OffsetY=90, Zoom=0.3, Rotate=150, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.13s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#34D399" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-650, Rotate=-340, Duration=1.8s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-130" Canvas.Top="545"
                                anim:Animate.Appear="{anim:Custom OffsetX=130, OffsetY=175, Zoom=0.3, Rotate=-170, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.1s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#F472B6" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-720, Rotate=460, Duration=1.9s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-60" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=60, OffsetY=200, Zoom=0.3, Rotate=130, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.12s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#FBBF24" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-760, Rotate=-420, Duration=2s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="40" Canvas.Top="555"
                                anim:Animate.Appear="{anim:Custom OffsetX=-40, OffsetY=195, Zoom=0.3, Rotate=-150, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.11s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#8B7CFF" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-750, Rotate=380, Duration=2s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="120" Canvas.Top="550"
                                anim:Animate.Appear="{anim:Custom OffsetX=-120, OffsetY=180, Zoom=0.3, Rotate=160, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.13s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#38BDF8" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-730, Rotate=-460, Duration=1.9s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="190" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=-190, OffsetY=140, Zoom=0.3, Rotate=-130, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.1s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#34D399" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-700, Rotate=320, Duration=1.8s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="250" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=-250, OffsetY=60, Zoom=0.3, Rotate=150, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.12s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#FBBF24" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-620, Rotate=-300, Duration=1.7s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="310" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=-310, OffsetY=-20, Zoom=0.3, Rotate=-160, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.11s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#F472B6" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-540, Rotate=280, Duration=1.5s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="230" Canvas.Top="570"
                                anim:Animate.Appear="{anim:Custom OffsetX=-230, OffsetY=-100, Zoom=0.3, Rotate=120, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.14s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#8B7CFF" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-470, Rotate=-240, Duration=1.4s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="280" Canvas.Top="550"
                                anim:Animate.Appear="{anim:Custom OffsetX=-280, OffsetY=170, Zoom=0.3, Rotate=-140, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.1s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#38BDF8" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-720, Rotate=440, Duration=1.9s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="170" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=-170, OffsetY=-60, Zoom=0.3, Rotate=170, Duration=0.7s, Easing=StrongEaseOut, StartAfter=0.12s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#34D399" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-500, Rotate=-260, Duration=1.5s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-350" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=350, OffsetY=120, Zoom=0.3, Duration=0.8s, Easing=StrongEaseOut, StartAfter=0.15s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#FBBF24" Width="7" Height="7" CornerRadius="4" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-680, Duration=1.9s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="350" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=-350, OffsetY=110, Zoom=0.3, Duration=0.8s, Easing=StrongEaseOut, StartAfter=0.15s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#F472B6" Width="7" Height="7" CornerRadius="4" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-670, Duration=1.9s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="-200" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=200, OffsetY=200, Zoom=0.3, Duration=0.8s, Easing=StrongEaseOut, StartAfter=0.16s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#38BDF8" Width="6" Height="6" CornerRadius="3" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-760, Duration=2.1s, Easing=EaseIn}" />
                        </Border>
                        <Border Style="{StaticResource Confetto}" Canvas.Left="210" Canvas.Top="560"
                                anim:Animate.Appear="{anim:Custom OffsetX=-210, OffsetY=205, Zoom=0.3, Duration=0.8s, Easing=StrongEaseOut, StartAfter=0.16s}">
                            <Border Style="{StaticResource ConfettoPiece}" Background="#8B7CFF" Width="6" Height="6" CornerRadius="3" anim:Animate.Appear="{anim:Custom Opacity=1, OffsetY=-765, Duration=2.1s, Easing=EaseIn}" />
                        </Border>
                    </Canvas>

                    <!-- The card. Its size follows its content, with a spring, and so does the rest of
                         the page. The same timing as the Magic moves between its steps, so that what
                         travels stays inside it. -->
                    <Border x:Name="Card" Background="{StaticResource CardBrush}" CornerRadius="28"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsIdle, Converter={StaticResource InverseBooleanToVisibility}}"
                            anim:Animate.MagicMoveId="Card" anim:Animate.MagicMoveSettings="{anim:MagicMove Travel=Above, Duration=0.6s}"
                            anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside, Duration=0.55s, Easing=Overshoot}">
                        <Border.Effect>
                            <DropShadowEffect Color="#1C1E2B" BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.35" />
                        </Border.Effect>
                        <Grid>

                            <!-- 1. Where and what to ship -->
                            <Grid x:Name="ConfigureStep" Visibility="{Binding IsConfiguring, Converter={StaticResource BooleanToVisibility}}"
                                  anim:Animate.Appear="None" anim:Animate.Disappear="None">
                                <StackPanel x:Name="ConfigureCard" Margin="20,18,20,20"
                                            Width="{Responsive ElementName=CardArea, Threshold=460, Mobile=264, Desktop=400}"
                                            anim:Animate.Appear="{StaticResource StepAppear}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AppIconBrush}">
                                            <TextBlock Text="N" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="storefront" Style="{StaticResource CardText}" FontSize="15" FontWeight="SemiBold" />
                                                <Border Background="#1FFFFFFF" CornerRadius="5" Padding="6,1,6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="DEMO" FontSize="9.5" FontWeight="Bold" CharacterSpacing="100" Foreground="{StaticResource CardMutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="northwind / main · v2.4.0" Style="{StaticResource MutedText}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource RoundButton}" Command="{Binding Close}" VerticalAlignment="Center"
                                                anim:Animate.Hover="Grow" anim:Animate.Press="Shrink">
                                            <Path Style="{StaticResource CloseIcon}" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="SHIP TO" Style="{StaticResource Overline}" Margin="2,20,0,8" />
                                    <Border Background="{StaticResource CardSurfaceBrush}" CornerRadius="13" Padding="3">
                                        <ListBox x:Name="TargetPicker" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource SegmentItem}"
                                                 ItemsPanel="{StaticResource OneRow}" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target, Mode=TwoWay}" />
                                    </Border>
                                    <TextBlock Text="{Binding Target.Details}" Style="{StaticResource MutedText}" FontFamily="{StaticResource CodeFont}" Margin="2,9,0,0"
                                               anim:Animate.TextChange="CrossFade" />

                                    <!-- Only for production: it slides in, and the card grows to make room -->
                                    <Border x:Name="ProductionWarning" Background="#1FFB7185" BorderBrush="#4DFB7185" BorderThickness="1" CornerRadius="12"
                                            Padding="12,9" Margin="0,12,0,0"
                                            Visibility="{Binding Target.IsProduction, Converter={StaticResource BooleanToVisibility}}"
                                            anim:Animate.Appear="{anim:Slide From=Top, Distance=Short}" anim:Animate.Disappear="{anim:Fade Duration=0.15s}">
                                        <TextBlock FontSize="12.5" Foreground="#FECDD3" TextWrapping="Wrap">
                                            <Run Text="Heads up: " FontWeight="Bold" /><Run Text="18,240 shoppers are online right now." />
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Text="COMMIT" Style="{StaticResource Overline}" Margin="2,20,0,6" />
                                    <ListBox x:Name="CommitList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CommitItem}" Margin="-10,0"
                                             ItemsSource="{Binding Commits}" SelectedItem="{Binding Commit, Mode=TwoWay}" />

                                    <!-- The button shows once a commit is picked. Its label retypes the environment. -->
                                    <Grid Margin="0,16,0,0">
                                        <TextBlock x:Name="PickHint" Text="Pick a commit to ship it" Style="{StaticResource MutedText}" FontSize="12.5"
                                                   HorizontalAlignment="Center" Margin="0,14"
                                                   Visibility="{Binding HasCommit, Converter={StaticResource InverseBooleanToVisibility}}"
                                                   anim:Animate.Appear="Fade" anim:Animate.Disappear="{anim:Fade Duration=0.12s}" />
                                        <Button x:Name="ReviewButton" Style="{StaticResource ActionButton}" Command="{Binding Review}"
                                                Visibility="{Binding HasCommit, Converter={StaticResource BooleanToVisibility}}"
                                                anim:Animate.Appear="{anim:Zoom From=0.85, Easing=Overshoot, Duration=0.45s}"
                                                anim:Animate.MagicMoveId="ShipAction" anim:Animate.MagicMoveSettings="{anim:MagicMove Duration=0.55s, Easing=Smooth}"
                                                anim:Animate.Hover="{anim:Grow Zoom=1.02}" anim:Animate.Press="Shrink">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Target.Name, StringFormat='Ship to {0}'}" anim:Animate.TextChange="Retype" />
                                                <Path Style="{StaticResource ArrowIcon}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Are you sure? A compact bar, where the avatar, the environment and the
                                 button arrive from the step before. Its Appear gives the card a timing
                                 without overshoot for this step, so that the card doesn't get smaller
                                 than the bar on the way, and shows the rest once the card is small. -->
                            <Grid x:Name="ConfirmStep" Visibility="{Binding IsConfirming, Converter={StaticResource BooleanToVisibility}}"
                                  anim:Animate.Appear="{anim:Fade Duration=0.25s, StartAfter=0.3s, OthersDuration=0.6s, Easing=StrongEaseInOut}" anim:Animate.Disappear="None">
                                <StackPanel x:Name="ConfirmBar" Margin="16,16,16,16"
                                            Width="{Responsive ElementName=CardArea, Threshold=460, Mobile=264, Desktop=340}">
                                    <Grid Margin="2,0,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CommitAvatar}" Width="38" Height="38" CornerRadius="19"
                                                anim:Animate.MagicMoveSettings="{anim:MagicMove Duration=0.6s, Easing=StrongEaseInOut}">
                                            <TextBlock Text="{Binding Commit.Initial}" FontSize="15" FontWeight="Bold" Foreground="#0C0C14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Commit.Hash, StringFormat='Ship {0} to'}" Style="{StaticResource CardText}" FontSize="14"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"
                                                           anim:Animate.Appear="{StaticResource StepAppear}" />
                                                <Border Style="{StaticResource TargetChip}"
                                                        anim:Animate.MagicMoveSettings="{anim:MagicMove Duration=0.6s, Easing=StrongEaseInOut}">
                                                    <TextBlock Text="{Binding Target.Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Commit.Message}" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       anim:Animate.Appear="{StaticResource StepAppear}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ActionButton}" Background="#1FFFFFFF" Foreground="{StaticResource CardTextBrush}" Command="{Binding Cancel}"
                                                Content="Cancel" anim:Animate.Appear="{StaticResource StepAppear}"
                                                anim:Animate.Hover="{anim:Grow Zoom=1.03}" anim:Animate.Press="Shrink" />
                                        <Button Grid.Column="2" Style="{StaticResource ActionButton}" Command="{Binding Ship}"
                                                anim:Animate.MagicMoveId="ShipAction" anim:Animate.MagicMoveSettings="{anim:MagicMove Duration=0.6s, Easing=StrongEaseInOut}"
                                                anim:Animate.Hover="{anim:Grow Zoom=1.03}" anim:Animate.Press="Shrink">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Ship it" />
                                                <Path Style="{StaticResource ArrowIcon}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Live: what was shipped, in three tabs -->
                            <Grid x:Name="LiveStep" Visibility="{Binding IsLive, Converter={StaticResource BooleanToVisibility}}"
                                  anim:Animate.Appear="None" anim:Animate.Disappear="None">
                                <StackPanel x:Name="LiveCard" Margin="20,18,20,18"
                                            Width="{Responsive ElementName=CardArea, Threshold=460, Mobile=264, Desktop=400}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CommitAvatar}" Width="40" Height="40" CornerRadius="20">
                                            <TextBlock Text="{Binding Commit.Initial}" FontSize="16" FontWeight="Bold" Foreground="#0C0C14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,1,7,0">
                                                    <Ellipse Fill="#4034D399" anim:Animate.Appear="{anim:Custom Zoom=3, Duration=0.9s, StartAfter=0.35s, Easing=StrongEaseOut}" />
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource MintBrush}" anim:Animate.Appear="{anim:Pop StartAfter=0.25s}" />
                                                </Grid>
                                                <TextBlock Text="Live on" Style="{StaticResource CardText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"
                                                           anim:Animate.Appear="{StaticResource StepAppear}" />
                                                <Border Style="{StaticResource TargetChip}">
                                                    <TextBlock Text="{Binding Target.Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Target.Url}" Style="{StaticResource MutedText}" FontFamily="{StaticResource CodeFont}" Margin="0,3,0,0"
                                                       anim:Animate.Appear="{anim:Typewriter StartAfter=0.3s, BlinkFirst=0.2s, Speed=40}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource RoundButton}" Command="{Binding Close}" VerticalAlignment="Center"
                                                anim:Animate.Hover="Grow" anim:Animate.Press="Shrink" anim:Animate.Appear="{StaticResource StepAppear}">
                                            <Path Style="{StaticResource CloseIcon}" />
                                        </Button>
                                    </Grid>

                                    <!-- The tab's content: the card resizes to each one -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid Visibility="{Binding IsChecked, ElementName=OverviewTab, Converter={StaticResource BooleanToVisibility}}"
                                              anim:Animate.Appear="None" anim:Animate.Disappear="None">
                                            <UniformGrid x:Name="OverviewPanel" Rows="1" Margin="-4,0"
                                                         anim:Animate.ItemsAppear="{anim:Slide Distance=Short, Duration=0.4s, StartAfter=0.12s}" anim:Animate.ItemsCascade="0.06s">
                                                <Border Style="{StaticResource Tile}" anim:Animate.Hover="Lift">
                                                    <StackPanel>
                                                        <TextBlock Text="Build" Style="{StaticResource MutedText}" FontSize="11" />
                                                        <TextBlock Text="{Binding BuildTime}" Style="{StaticResource TileValue}" anim:Animate.TextChange="CountUp" />
                                                        <TextBlock Text="6 s faster" FontSize="11" Foreground="{StaticResource MintBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Tile}" anim:Animate.Hover="Lift">
                                                    <StackPanel>
                                                        <TextBlock Text="Tests" Style="{StaticResource MutedText}" FontSize="11" />
                                                        <TextBlock Text="{Binding TestCount}" Style="{StaticResource TileValue}" anim:Animate.TextChange="CountUp" />
                                                        <TextBlock Text="all green" FontSize="11" Foreground="{StaticResource MintBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Tile}" anim:Animate.Hover="Lift">
                                                    <StackPanel>
                                                        <TextBlock Text="p95" Style="{StaticResource MutedText}" FontSize="11" />
                                                        <TextBlock Text="{Binding Latency}" Style="{StaticResource TileValue}" anim:Animate.TextChange="CountUp" />
                                                        <TextBlock Text="14 ms less" FontSize="11" Foreground="{StaticResource MintBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </Grid>

                                        <Grid Visibility="{Binding IsChecked, ElementName=ChecksTab, Converter={StaticResource BooleanToVisibility}}"
                                              anim:Animate.Appear="None" anim:Animate.Disappear="None">
                                            <ListBox x:Name="ChecksPanel" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CheckItem}" Margin="-10,-4"
                                                     ItemsSource="{Binding Checks}"
                                                     anim:Animate.ItemsAppear="{anim:Slide From=Left, Distance=Short, Duration=0.4s, StartAfter=0.05s}" anim:Animate.ItemsCascade="0.05s">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="18" Height="18" CornerRadius="9" Background="#2634D399" VerticalAlignment="Center">
                                                                <Path Data="M1,4 L3.2,6.2 L7.5,1.5" Stroke="{StaticResource MintBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CardText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Result}" Style="{StaticResource MutedText}" FontFamily="{StaticResource CodeFont}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>

                                        <Grid Visibility="{Binding IsChecked, ElementName=TrafficTab, Converter={StaticResource BooleanToVisibility}}"
                                              anim:Animate.Appear="None" anim:Animate.Disappear="None">
                                            <StackPanel x:Name="TrafficPanel" anim:Animate.Appear="{StaticResource TabAppear}">
                                                <Grid>
                                                    <TextBlock Text="REQUESTS / MIN" Style="{StaticResource Overline}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                    <Border Background="{StaticResource CardSurfaceBrush}" CornerRadius="9" Padding="2" HorizontalAlignment="Right">
                                                        <ListBox x:Name="RangePicker" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RangeItem}"
                                                                 ItemsPanel="{StaticResource OneRow}" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range, Mode=TwoWay}" />
                                                    </Border>
                                                </Grid>

                                                <!-- When the period changes, the bars change height one after the other, like a wave.
                                                     The green ones are the new release. -->
                                                <ListBox x:Name="TrafficChart" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource BarItem}"
                                                         ItemsPanel="{StaticResource OneRow}" ItemsSource="{Binding Bars}" Height="100" Margin="-3,8,-3,0"
                                                         anim:Animate.ItemsAppear="{anim:Wipe From=Bottom, Duration=0.5s, Easing=StrongEaseOut}" anim:Animate.ItemsCascade="0.04s"
                                                         anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside, Duration=0.55s, Easing=Overshoot, Bounciness=0.4, Wave=1.5}" />
                                                <Grid Margin="2,6,2,0">
                                                    <TextBlock Text="{Binding Range.Since}" Style="{StaticResource MutedText}" FontSize="10.5" anim:Animate.TextChange="CrossFade" />
                                                    <TextBlock Text="now" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Margin="2,12,2,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Range.Requests}" Style="{StaticResource CardText}" FontWeight="SemiBold" anim:Animate.TextChange="CountUp" />
                                                        <TextBlock Text=" on average" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Range.Errors}" Foreground="{StaticResource MintBrush}" FontSize="13" FontWeight="SemiBold"
                                                                   anim:Animate.TextChange="CountUp" />
                                                        <TextBlock Text=" errors" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <Border Background="{StaticResource CardSurfaceBrush}" CornerRadius="13" Padding="3" Margin="0,16,0,0"
                                            anim:Animate.Appear="{StaticResource StepAppear}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="OverviewTab" Content="Overview" Style="{StaticResource TabButton}" GroupName="LiveTabs" IsChecked="{Binding IsOverviewTab, Mode=TwoWay}" />
                                            <RadioButton x:Name="ChecksTab" Content="Checks" Style="{StaticResource TabButton}" GroupName="LiveTabs" />
                                            <RadioButton x:Name="TrafficTab" Content="Traffic" Style="{StaticResource TabButton}" GroupName="LiveTabs" />
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- What makes it work, below the demo -->
                <Border x:Name="Facts" BorderBrush="#1A5B5BD6" BorderThickness="0,1,0,0" Margin="{Responsive Mobile='0,28,0,0', Tablet='40,40,40,0'}" Padding="0,18,0,0"
                        anim:Animate.Appear="{anim:Custom OffsetY=12, Duration=0.8s, Easing=StrongEaseOut, StartAfter=1.4s}">
                    <StackPanel>
                        <UniformGrid Rows="1" anim:Animate.ItemsAppear="{anim:Pop StartAfter=1.5s}" anim:Animate.ItemsCascade="0.12s">
                            <StackPanel>
                                <TextBlock Text="0" Style="{StaticResource FactNumber}" />
                                <TextBlock Text="storyboards" Style="{StaticResource FactName}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="0" Style="{StaticResource FactNumber}" />
                                <TextBlock Text="timers" Style="{StaticResource FactName}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="0" Style="{StaticResource FactNumber}" />
                                <TextBlock Text="lines of animation code" Style="{StaticResource FactName}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Each click only changes a property of the view model. Everything that moves is an attribute in the XAML, like Appear, MagicMoveId or MoveAndResize." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
