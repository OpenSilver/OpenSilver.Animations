<UserControl x:Class="OpenSilver.Animations.Gallery.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
             FontFamily="{StaticResource UiFont}"
             FontSize="14"
             Foreground="{StaticResource TextBrush}"
             SizeChanged="MainPage_SizeChanged">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ChaptersColumn" Width="272" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="LogColumn" Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Border Grid.ColumnSpan="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="{Responsive Mobile='8,8', Tablet='20,10'}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Margin="0,0,4,0" VerticalAlignment="Center" Click="MenuButton_Click"
                        Visibility="{Responsive Mobile=Visible, Tablet=Collapsed}">
                    <Path Width="18" Height="14" Data="M 1,1 L 17,1 M 1,7 L 17,7 M 1,13 L 17,13" Stroke="{StaticResource TextBrush}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>

                <!-- The logo and the title go back to the welcome page. The negative margin keeps them where they were without the padding. -->
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Foreground="{StaticResource TextBrush}" FontWeight="Normal"
                        Padding="6,4" Margin="-6,-4,0,-4" HorizontalAlignment="Left" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Back to the welcome page" Click="Home_Click">
                    <StackPanel Orientation="Horizontal">
                        <!-- The logo: a box that moves, leaving a trail. The same drawing is favicon.svg. -->
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <Canvas Width="34" Height="34">
                                <Border Canvas.Left="6" Canvas.Top="11" Width="12" Height="12" CornerRadius="3.5" Background="White" Opacity="0.25" />
                                <Border Canvas.Left="11" Canvas.Top="11" Width="12" Height="12" CornerRadius="3.5" Background="White" Opacity="0.5" />
                                <Border Canvas.Left="16" Canvas.Top="11" Width="12" Height="12" CornerRadius="3.5" Background="White" />
                            </Canvas>
                        </Border>
                        <StackPanel Margin="{Responsive Mobile='10,0,0,0', Tablet='12,0,0,0'}" VerticalAlignment="Center">
                            <TextBlock Text="OpenSilver.Animations" FontSize="{Responsive Mobile=15, Tablet=16}" FontWeight="Bold" />
                            <TextBlock Text="A guided tour of the library" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- On phones, the options move to the menu -->
                <StackPanel x:Name="ToolbarHost" Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel x:Name="Toolbar" Orientation="{Responsive Mobile=Vertical, Tablet=Horizontal}">
                        <CheckBox x:Name="SlowMotionSwitch" Content="Slow motion" Style="{StaticResource SwitchCheckBox}"
                                  Checked="SlowMotionSwitch_Changed" Unchecked="SlowMotionSwitch_Changed" />
                        <CheckBox Content="Show what animates" Style="{StaticResource SwitchCheckBox}" Margin="{Responsive Mobile=0, Tablet='8,0,0,0'}"
                                  IsChecked="{Binding ShowWhatAnimates, Mode=TwoWay}" />
                        <CheckBox Content="Reduce motion" Style="{StaticResource SwitchCheckBox}" Margin="{Responsive Mobile=0, Tablet='8,0,0,0'}"
                                  IsChecked="{Binding SimulateReducedMotion, Mode=TwoWay}" />
                        <Button Content="Replay page" Style="{StaticResource SecondaryButton}" Padding="14,7" HorizontalAlignment="Left"
                                Margin="{Responsive Mobile='8,8,0,0', Tablet='16,0,0,0'}" Click="ReplayPage_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- When the log is not beside the page, this button opens it -->
                <Button x:Name="LogButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Padding="12,7" VerticalAlignment="Center"
                        Margin="{Responsive Mobile='8,0,0,0', Tablet='16,0,0,0'}" Click="LogButton_Click"
                        Visibility="{Responsive Mobile=Visible, Tablet=Visible, Desktop=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Log" VerticalAlignment="Center" />
                        <Ellipse x:Name="UnreadDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Chapter page -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0">
            <sdk:Frame x:Name="ContentFrame" JournalOwnership="Automatic" HorizontalContentAlignment="Stretch" Navigated="ContentFrame_Navigated">
                <sdk:Frame.UriMapper>
                    <sdk:UriMapper>
                        <sdk:UriMapping Uri="" MappedUri="/Chapters/Welcome.xaml" />
                        <sdk:UriMapping Uri="/" MappedUri="/Chapters/Welcome.xaml" />
                        <sdk:UriMapping Uri="/chapter/1" MappedUri="/Chapters/Chapter01.xaml" />
                        <sdk:UriMapping Uri="/chapter/2" MappedUri="/Chapters/Chapter02.xaml" />
                        <sdk:UriMapping Uri="/chapter/3" MappedUri="/Chapters/Chapter03.xaml" />
                        <sdk:UriMapping Uri="/chapter/4" MappedUri="/Chapters/Chapter04.xaml" />
                        <sdk:UriMapping Uri="/chapter/5" MappedUri="/Chapters/Chapter05.xaml" />
                        <sdk:UriMapping Uri="/chapter/6" MappedUri="/Chapters/Chapter06.xaml" />
                        <sdk:UriMapping Uri="/chapter/7" MappedUri="/Chapters/Chapter07.xaml" />
                        <sdk:UriMapping Uri="/chapter/8" MappedUri="/Chapters/Chapter08.xaml" />
                        <sdk:UriMapping Uri="/chapter/10" MappedUri="/Chapters/Chapter10.xaml" />
                        <sdk:UriMapping Uri="/chapter/12" MappedUri="/Chapters/Chapter12.xaml" />
                        <sdk:UriMapping Uri="/chapter/13" MappedUri="/Chapters/Chapter13.xaml" />
                        <sdk:UriMapping Uri="/chapter/14" MappedUri="/Chapters/Chapter14.xaml" />
                        <sdk:UriMapping Uri="/chapter/{number}" MappedUri="/Chapters/ComingSoon.xaml?chapter={number}" />
                    </sdk:UriMapper>
                </sdk:Frame.UriMapper>
            </sdk:Frame>
        </ScrollViewer>

        <!-- Dims the page behind an open drawer; a tap closes the drawer -->
        <Border x:Name="Scrim" Grid.Row="1" Grid.ColumnSpan="3" Background="#661C1E2B" Visibility="Collapsed"
                MouseLeftButtonDown="Scrim_MouseLeftButtonDown" />

        <!-- Chapters: a column, or a drawer on phones -->
        <Border x:Name="ChaptersPanel" Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0">
                <StackPanel Margin="12,20,12,20">
                    <StackPanel x:Name="DrawerOptions" Visibility="Collapsed" Margin="0,0,0,20">
                        <TextBlock Text="OPTIONS" Style="{StaticResource OverlineText}" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,6" />
                    </StackPanel>
                    <TextBlock Text="CHAPTERS" Style="{StaticResource OverlineText}" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,10" />
                    <ItemsControl x:Name="ChapterList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChapterButton}" Background="{Binding Background}" Tag="{Binding}" Click="Chapter_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{Binding NumberBackground}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold" Foreground="{Binding NumberForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{Binding TitleForeground}" FontWeight="{Binding TitleWeight}" />
                                        <TextBlock Grid.Column="2" Text="soon" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding SoonVisibility}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- What just happened: a column, or a drawer on smaller screens -->
        <Border x:Name="LogPanel" Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="20,20,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="What just happened" Style="{StaticResource HeadingText}" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Style="{StaticResource LinkButton}" Click="ClearLog_Click" />
                        <Button x:Name="CloseLogButton" Content="Close" Style="{StaticResource LinkButton}" Click="CloseLog_Click"
                                Visibility="{Responsive Mobile=Visible, Tablet=Visible, Desktop=Collapsed}" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Margin="0,4,8,12"
                           Text="Why each change animated or not, newest first. These are the messages of AnimationSettings.Logged." />
                <TextBlock x:Name="EmptyLogText" Grid.Row="2" Style="{StaticResource BodyText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,8,0"
                           Text="Try a demo: its explanation shows up here." />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0">
                    <ItemsControl x:Name="LogList" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource StageBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionText}" FontSize="11" />
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" FontSize="13" LineHeight="19" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
