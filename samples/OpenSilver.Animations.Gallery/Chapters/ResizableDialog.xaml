<ChildWindow x:Class="OpenSilver.Animations.Gallery.Chapters.ResizableDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="http://opensilver.net/animations"
             Title="Project settings"
             Width="300"
             FontFamily="{StaticResource UiFont}"
             anim:Animate.MoveAndResize="Smooth">
    <StackPanel Margin="8">
        <TextBlock Style="{StaticResource BodyText}"
                   Text="Make the dialog wider: it grows and stays centered, and the text box below stretches with it." />
        <TextBlock Text="Project name" Style="{StaticResource CaptionText}" Margin="0,16,0,4" />
        <TextBox Text="My OpenSilver app" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="WiderButton" Content="Make it wider" Style="{StaticResource SecondaryButton}" Click="WiderButton_Click" />
            <Button Content="Close" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
</ChildWindow>
