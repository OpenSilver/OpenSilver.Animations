<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.MagicMoveChapter"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="Magic move">

    <sdk:Page.Resources>
        <!-- A button of a segmented control: the pill behind its label shows when it is checked -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Pill" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <Visibility>Visible</Visibility>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Pill" Background="White" BorderBrush="#D9DCE7" BorderThickness="1" CornerRadius="8" Visibility="Collapsed"
                                    anim:Animate.MagicMove="SelectionPill" />
                            <ContentPresenter Margin="{Responsive Mobile='12,7', Tablet='18,7'}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <!-- A photo of the list: the whole tile can be clicked -->
        <Style x:Key="PhotoTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Without the focus glow of the theme, which would jump from the small box to the card:
             the box around it shows where to type -->
        <Style x:Key="PlainTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="ContentElement" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DCE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- The steps of the wizard: each one has an Avatar, a Heading, a Subtitle, a Progress, a BackButton
             and a NextButton, and the last two a ProPlan -->
        <DataTemplate x:Key="WizardStep1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border x:Name="Avatar" Width="56" Height="56" CornerRadius="999" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="AM" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Heading" Text="Create your account" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" />
                    <TextBlock x:Name="Subtitle" Text="We only need your name and your email." Style="{StaticResource BodyText}" Margin="0,4,0,12" />
                    <Border Style="{StaticResource Field}">
                        <TextBlock Text="Ada Martin" FontSize="14" Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <Border Style="{StaticResource Field}" Margin="0,8,0,0">
                        <TextBlock Text="ada@example.com" FontSize="14" Foreground="{StaticResource TextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="Progress" Grid.Row="1" Text="Step 1 of 3" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="WizardNext_Click" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WizardStep2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="Heading" Text="Choose a plan" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,48,0" />
                    <TextBlock x:Name="Subtitle" Text="You can change it at any time." Style="{StaticResource BodyText}" Margin="0,4,48,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Field}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Free" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="For one person" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ProPlan" Grid.Column="2" Background="{StaticResource AccentLightBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Pro" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" />
                                <TextBlock Text="$8 a month" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
                <Border x:Name="Avatar" Width="36" Height="36" CornerRadius="999" Background="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="AM" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Progress" Grid.Row="1" Text="Step 2 of 3" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}" Click="WizardBack_Click" />
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="WizardNext_Click" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WizardStep3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="Avatar" Width="88" Height="88" CornerRadius="999" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="AM" Foreground="White" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Heading" Text="You're all set, Ada" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="Subtitle" Text="Your account is ready." Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <Border x:Name="ProPlan" Background="{StaticResource AccentLightBrush}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Pro plan" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}" Click="WizardBack_Click" />
                        <Button x:Name="NextButton" Content="Start over" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="WizardNext_Click" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="Progress" Grid.Row="1" Text="Step 3 of 3" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </sdk:Page.Resources>

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 2" Style="{StaticResource OverlineText}" />
        <TextBlock Text="Magic move" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Chapter 1 made elements fade in and out. Magic move goes further: when an element disappears and another one with the same id appears, the second one starts where the first one was, and travels to its own place, while the two cross-fade. It is the trick behind steps that flow into each other, text boxes that open into a card, and photos that open where they are." />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="In a ContentControl whose content is replaced, MagicMoveByName gives the ids for you: the elements with the same x:Name travel. Anywhere else, give the two elements the same id with Animate.MagicMove. They can be in two templates, in two lists, in a popup, or inside panels that appear and disappear. They only need to change at the same moment." />

        <!-- 1. Wizard -->
        <controls:DemoCard Title="Steps that flow into each other"
                           Description="The steps of this wizard are replaced in a ContentControl with MagicMoveByName. The elements with the same x:Name in two steps travel from one to the other, like the avatar, the heading, the line below it and the buttons, while the rest of the steps cross-fade."
                           Xaml='&lt;ContentControl x:Name="WizardHost" anim:Animate.MagicMoveByName="True" /&gt;&#10;&#10;&lt;!-- In each step --&gt;&#10;&lt;Border x:Name="Avatar" … /&gt;&#10;&lt;TextBlock x:Name="Heading" … /&gt;&#10;&lt;TextBlock x:Name="Subtitle" … /&gt;&#10;&lt;Button x:Name="BackButton" … /&gt;&#10;&lt;Button x:Name="NextButton" … /&gt;'
                           Expectations="• Next: the avatar, the heading, the line below it, the step number and the buttons travel to their places in the next step, while the rest of the step cross-fades.&#10;• The texts change on the way: the old one fades out as the new one fades in. In the last step, Next becomes Start over, and the buttons move to the middle.&#10;• In the last step, the Pro plan card shrinks into a small badge. Back goes the other way, and Start over takes everything back to the first step.">
            <Border Style="{StaticResource Card}" Width="{Responsive Mobile=NaN, Tablet=440}" HorizontalAlignment="{Responsive Mobile=Stretch, Tablet=Left}">
                <ContentControl x:Name="WizardHost" Height="{Responsive Mobile=320, Tablet=300}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                anim:Animate.MagicMoveByName="True" />
            </Border>
        </controls:DemoCard>

        <!-- 2. A text box that opens into a popup -->
        <controls:DemoCard Title="A text box that opens into a popup"
                           Description="Click the text box. A Popup opens over it with a larger card to write in, and a binding to IsOpen collapses the text box while the popup is open. The text box and the card have the same id: the text box grows into the card, and the card shrinks back into the text box when the popup closes."
                           Xaml='&lt;Grid x:Name="AskAnchor" Height="40"&gt;&#10;    &lt;!-- Collapsed while the popup is open --&gt;&#10;    &lt;Border anim:Animate.MagicMove="AskBox"&#10;            Visibility="{Binding IsOpen, ElementName=AskPopup,&#10;                                 Converter={StaticResource InverseBooleanToVisibility}}"&gt;&#10;        &lt;TextBox GotFocus="AskBox_GotFocus" /&gt;&#10;    &lt;/Border&gt;&#10;&#10;    &lt;!-- Opens over the text box. StayOpen=False closes it on a click outside --&gt;&#10;    &lt;Popup x:Name="AskPopup" StayOpen="False" Placement="Bottom" VerticalOffset="-40"&#10;           PlacementTarget="{Binding ElementName=AskAnchor}"&gt;&#10;        &lt;Border anim:Animate.MagicMove="AskBox" Width="{Binding ActualWidth, ElementName=AskAnchor}"&gt;&#10;            &lt;!-- A larger text box and a Send button --&gt;&#10;        &lt;/Border&gt;&#10;    &lt;/Popup&gt;&#10;&lt;/Grid&gt;&#10;&#10;// AskBox_GotFocus&#10;AskPopup.IsOpen = true;'
                           Expectations="• Click the text box: it grows into the card, which opens over it, and you can type in the card at once. Nothing flashes before it grows, and no focus frame jumps from the text box to the card: the border of the card shows where you type.&#10;• Click outside the card, press Escape, or click Send: the card shrinks back into the text box.&#10;• What you type in one is in the other, and Send empties it.">
            <Grid x:Name="AskAnchor" Height="40" Width="{Responsive Mobile=NaN, Tablet=520}" HorizontalAlignment="{Responsive Mobile=Stretch, Tablet=Left}">
                <Border Background="White" BorderBrush="#D9DCE7" BorderThickness="1" CornerRadius="20"
                        anim:Animate.MagicMove="AskBox"
                        Visibility="{Binding IsOpen, ElementName=AskPopup, Converter={StaticResource InverseBooleanToVisibility}}">
                    <Grid>
                        <TextBox x:Name="AskBox" Style="{StaticResource PlainTextBox}" Padding="18,0" VerticalAlignment="Center"
                                 GotFocus="AskBox_GotFocus" TextChanged="AskText_Changed" />
                        <TextBlock x:Name="AskPlaceholder" Text="Ask anything about animations" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                                   Margin="18,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Popup x:Name="AskPopup" StayOpen="False" Placement="Bottom" VerticalOffset="-40" PlacementTarget="{Binding ElementName=AskAnchor}"
                       Opened="AskPopup_Opened">
                    <Border Width="{Binding ActualWidth, ElementName=AskAnchor}" Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="12,10" anim:Animate.MagicMove="AskBox" KeyDown="AskCard_KeyDown">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" Color="Black" BlurRadius="14" Opacity="0.15" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid>
                                <TextBox x:Name="AskCardBox" Style="{StaticResource PlainTextBox}" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                         Padding="6,2"
                                         Text="{Binding Text, ElementName=AskBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Name="AskCardPlaceholder" Text="Ask anything about animations" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="6,2,0,0" IsHitTestVisible="False" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="Click outside to close" Style="{StaticResource CaptionText}" VerticalAlignment="Top" />
                                <Button Content="Send" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="AskSend_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </controls:DemoCard>

        <!-- 3. Chips -->
        <controls:DemoCard Title="Toppings that change lists"
                           Description="Click a topping to put it on the pizza, or to take it off. The code removes it from its list and adds a new one with the same id to the other list: the new one travels from where the old one was, above everything."
                           Xaml='// Each topping has an id of its own&#10;Animate.SetMagicMove(chip, "topping-" + name);&#10;&#10;// Moving it: remove it from one list, and add a new one to the other&#10;Available.Children.Remove(chip);&#10;Chosen.Children.Add(CreateChip(name));'
                           Expectations="• The topping you click travels to the end of the other list, above everything.&#10;• The toppings after it in its old list slide over to fill its place.&#10;• Click several toppings quickly: each one travels on its own.">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Responsive Mobile=12, Tablet=24}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AVAILABLE" Style="{StaticResource OverlineText}" Margin="0,0,0,8" />
                    <WrapPanel x:Name="AvailableToppings" MinHeight="40" anim:Animate.ItemsMoveAndResize="Smooth" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,12,4,4">
                    <StackPanel>
                        <TextBlock Text="ON YOUR PIZZA" Style="{StaticResource OverlineText}" Margin="0,0,0,8" />
                        <WrapPanel x:Name="ChosenToppings" MinHeight="40" anim:Animate.ItemsMoveAndResize="Smooth" />
                    </StackPanel>
                </Border>
            </Grid>
        </controls:DemoCard>

        <!-- 4. Selection pill -->
        <controls:DemoCard Title="A selection pill that slides"
                           Description="Each button of this segmented control has its own white pill in its template, shown only when the button is checked. All the pills have the same id: when you click another button, its pill travels from the one that was shown."
                           Xaml='&lt;!-- In the template of the RadioButton, shown when it is checked --&gt;&#10;&lt;Border x:Name="Pill" Visibility="Collapsed" anim:Animate.MagicMove="SelectionPill" /&gt;&#10;&#10;&lt;!-- With parameters --&gt;&#10;anim:Animate.MagicMove="{anim:MagicMove Id=SelectionPill, Duration=0.4s, Easing=Bouncy}"'
                           Expectations="• The white pill slides from the checked button to the one you click, behind the labels, which never disappear under it.&#10;• It stretches or shrinks when the buttons have different widths, like Day and Month.&#10;• Click quickly from one button to another: the pill turns around from where it is, without jumping.">
            <Border Background="#E9EBF2" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Day" GroupName="Range" Style="{StaticResource Segment}" />
                    <RadioButton Content="Week" GroupName="Range" Style="{StaticResource Segment}" IsChecked="True" />
                    <RadioButton Content="Month" GroupName="Range" Style="{StaticResource Segment}" />
                    <RadioButton Content="Year to date" GroupName="Range" Style="{StaticResource Segment}" />
                </StackPanel>
            </Border>
        </controls:DemoCard>

        <!-- 5. Photos -->
        <controls:DemoCard Title="A photo that opens where it is"
                           Description="Click a photo. The list is collapsed, and the details of the photo are shown in its place. The photo and its title have ids made from the photo's Id, in the list and in the details: they grow from their place in the list into the large photo and the heading. The rest of the list fades out, and the Grid that holds both resizes smoothly."
                           Xaml="&lt;Grid anim:Animate.MoveAndResize=&quot;Smooth&quot;&gt;&#10;    &lt;ItemsControl x:Name=&quot;PhotoList&quot; anim:Animate.Appear=&quot;Fade&quot; anim:Animate.Disappear=&quot;Fade&quot; /&gt;&#10;    &lt;StackPanel x:Name=&quot;PhotoDetails&quot; anim:Animate.Disappear=&quot;Fade&quot; /&gt;&#10;&lt;/Grid&gt;&#10;&#10;&lt;!-- In the list, and in the details: the same ids --&gt;&#10;&lt;Image Source=&quot;{Binding Image}&quot; anim:Animate.MagicMove=&quot;{Binding Id, StringFormat='photo-{0}'}&quot; /&gt;&#10;&lt;TextBlock Text=&quot;{Binding Title}&quot; anim:Animate.MagicMove=&quot;{Binding Id, StringFormat='title-{0}'}&quot; /&gt;"
                           Expectations="• The photo you click grows from its place into the large photo, and its title grows into the heading.&#10;• The other photos fade out, the description and the button fade in, and the demo grows to its new height smoothly.&#10;• Back to the photos makes them shrink back into their place in the list, while the other photos fade back in.">
            <Grid anim:Animate.MoveAndResize="Smooth">
                <ItemsControl x:Name="PhotoList" anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PhotoTile}" Margin="0,0,12,12" Click="Photo_Click">
                                <StackPanel Width="150">
                                    <Image Source="{Binding Image}" Width="150" Height="100" Stretch="UniformToFill"
                                           anim:Animate.MagicMove="{Binding Id, StringFormat='photo-{0}'}" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"
                                               anim:Animate.MagicMove="{Binding Id, StringFormat='title-{0}'}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="PhotoDetails" MaxWidth="480" HorizontalAlignment="Left" Visibility="Collapsed" anim:Animate.Disappear="Fade">
                    <Image Source="{Binding Image}" Height="{Responsive Mobile=200, Tablet=320}" Stretch="UniformToFill"
                           anim:Animate.MagicMove="{Binding Id, StringFormat='photo-{0}'}" />
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"
                               anim:Animate.MagicMove="{Binding Id, StringFormat='title-{0}'}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,4,0,0" anim:Animate.Appear="Fade" />
                    <Button Content="Back to the photos" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                            Click="BackToPhotos_Click" anim:Animate.Appear="Fade" />
                </StackPanel>
            </Grid>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The element that appears has 0.3 s to come after the one that disappears. When nothing comes, the one that disappeared plays its own Disappear, or disappears at once." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Elements travel above the page, so that nothing cuts them off. A background, like a selection pill, travels behind the elements around it instead, so that it never covers the labels. Set Travel=Above or Travel=Behind to choose." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The farther an element goes, the longer it takes: 0.5 s for a short trip, twice the default duration of the other animations, up to 0.9 s across the page. It starts very slowly, goes very fast in the middle, and ends very slowly, so that the eye can follow it. Set Duration and Easing to change that." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• A text grows or shrinks as a whole, like a picture, so that its words never wrap differently on the way. Boxes, like the pill and the cards, change their width and height." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• When several elements have the same id, like the pills of two segmented controls, each one travels from the nearest one." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Your elements don't change: what travels is a copy, and your element shows in its place when the copy lands. When the device asks for reduced motion, the two elements simply cross-fade in place." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="2" />
    </StackPanel>
</sdk:Page>
