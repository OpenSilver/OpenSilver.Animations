<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.ComingSoon"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls">

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock x:Name="ChapterLabel" Style="{StaticResource OverlineText}" />
        <TextBlock x:Name="ChapterTitle" Style="{StaticResource ChapterTitleText}" />
        <TextBlock x:Name="ChapterSummary" Style="{StaticResource IntroText}" />
        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Coming soon" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="This chapter arrives with the version of the library that brings its feature. Until then, the chapters that are ready are listed in the sidebar." />
            </StackPanel>
        </Border>
        <controls:ChapterNavigation x:Name="Navigation" />
    </StackPanel>
</sdk:Page>
