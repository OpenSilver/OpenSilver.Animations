<UserControl x:Class="OpenSilver.Animations.Gallery.Chapters.MiniShowcase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
             xmlns:anim="http://opensilver.net/animations"
             SizeChanged="MiniShowcase_SizeChanged">

    <!-- A small copy of the window of the OpenSilver Showcase, with the names and the values of its XAML -->
    <UserControl.Resources>
        <anim:Slide x:Key="MenuAnimation_OnAppear_Default" From="Left" Distance="50%" StartAfter="4.5s" Duration="1s" OthersDuration="1.5s" Easing="EaseOut" OnPageOpen="PushOthers" />
        <anim:Slide x:Key="MenuAnimation_OnAppear_Faster" From="Left" Distance="50%" Duration="0.5s" OthersDuration="0.75s" Easing="EaseOut" />

        <!-- Not in the Showcase yet: the menu slides out on small screens, and the pages have a transition -->
        <anim:Slide x:Key="MenuAnimation_OnDisappear" To="Left" Distance="50%" Duration="0.4s" OthersDuration="0.6s" Easing="EaseIn" />
        <anim:Slide x:Key="PageAnimation_OnAppear" From="Bottom" Distance="Short" Duration="0.4s" Easing="EaseOut" OnPageOpen="Skip" />
        <anim:Fade x:Key="PageAnimation_OnDisappear" Duration="0.2s" />

        <Style x:Key="MenuItem" TargetType="Button" BasedOn="{StaticResource ChapterButton}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="MenuHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="8,10,0,4" />
        </Style>
        <Style x:Key="Tab" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,10,10,6" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Color="Black" BlurRadius="10" Opacity="0.15" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabSmallText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SamplePage" TargetType="StackPanel">
            <Setter Property="Margin" Value="20,40,20,16" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="anim:Animate.Appear" Value="{StaticResource PageAnimation_OnAppear}" />
            <Setter Property="anim:Animate.Disappear" Value="{StaticResource PageAnimation_OnDisappear}" />
        </Style>
        <Style x:Key="OrderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="12,6" />
        </Style>
        <Style x:Key="SampleTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="SampleBox" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Particle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#405B5BD6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <!-- The browser around the window -->
    <Border Background="#E4E6EF" CornerRadius="12" Padding="6,0,6,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Ellipse Width="9" Height="9" Fill="#FF5F57" />
                <Ellipse Width="9" Height="9" Fill="#FEBC2E" Margin="5,0" />
                <Ellipse Width="9" Height="9" Fill="#28C840" />
            </StackPanel>
            <Border Background="#F7F8FC" CornerRadius="6" Padding="14,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="opensilvershowcase.com" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            </Border>

            <!-- The window -->
            <Grid Grid.Row="1" Height="{Responsive Mobile=460, Tablet=420}" ClipToBounds="True" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RowThatContainsThePage" Height="1*" />
                    <RowDefinition x:Name="RowThatContainsTheGridSplitter" Height="0" />
                    <RowDefinition x:Name="RowThatContainsTheSourceCodePane" Height="0*" />
                </Grid.RowDefinitions>

                <!-- Above the grid splitter and the source code pane, which slides up under it -->
                <Grid Canvas.ZIndex="1" ClipToBounds="True" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Background -->
                    <Border x:Name="BackgroundImagesContainer" Grid.ColumnSpan="2"
                            anim:Animate.Appear="{anim:Fade StartAfter=1s, Duration=1s, Easing=EaseOut}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E9EBFF" Offset="0" />
                                <GradientStop Color="#FBEEFA" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Menu -->
                    <Border x:Name="MenuContainer" Canvas.ZIndex="3" HorizontalAlignment="Left"
                            anim:Animate.Appear="{StaticResource MenuAnimation_OnAppear_Default}"
                            anim:Animate.Disappear="{StaticResource MenuAnimation_OnDisappear}">
                        <Border Width="150" Background="White">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" Color="Black" BlurRadius="12" Opacity="0.15" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0">
                                <StackPanel Margin="10,14,10,10">
                                    <Grid x:Name="Logo" Background="Transparent" Cursor="Hand" Margin="4,0,0,0"
                                          MouseLeftButtonDown="Logo_MouseLeftButtonDown" anim:Animate.Hover="Nudge">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentBrush}">
                                                <TextBlock Text="OS" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="OpenSilver" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="SHOWCASE" FontSize="7" FontWeight="Bold" CharacterSpacing="200" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="SearchControl" Background="{StaticResource StageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,5" Margin="0,14,0,6" anim:Animate.Hover="Nudge">
                                        <TextBlock Text="Search" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                    <Button x:Name="WelcomeItem" Content="Welcome" Style="{StaticResource MenuItem}" Click="WelcomeItem_Click" anim:Animate.Hover="Nudge" />
                                    <TextBlock Text="SAMPLES" Style="{StaticResource MenuHeading}" />
                                    <Button x:Name="ButtonsItem" Content="Buttons" Style="{StaticResource MenuItem}" Click="ButtonsItem_Click" anim:Animate.Hover="Nudge" />
                                    <Button x:Name="DataGridItem" Content="Data grid" Style="{StaticResource MenuItem}" Click="DataGridItem_Click" anim:Animate.Hover="Nudge" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Border>

                    <!-- The menu button, on small screens -->
                    <Border x:Name="ButtonToHideOrShowMenu" Grid.Column="1" Canvas.ZIndex="2" Visibility="Collapsed" Margin="4" VerticalAlignment="Top" HorizontalAlignment="Left"
                            anim:Animate.Appear="{anim:Fade StartAfter=0.1s, Duration=0.5s, Easing=EaseInOut}">
                        <Button Style="{StaticResource IconButton}" Padding="8" Click="ButtonToHideOrShowMenu_Click">
                            <Path Fill="{StaticResource TextBrush}" Opacity="0.5" Width="20" Height="14" Stretch="Fill"
                                  Data="M0,0 L20,0 L20,2.5 L0,2.5 Z M0,5.75 L20,5.75 L20,8.25 L0,8.25 Z M0,11.5 L20,11.5 L20,14 L0,14 Z" />
                        </Button>
                    </Border>

                    <!-- Page -->
                    <ScrollViewer x:Name="PageScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0" Background="Transparent">
                        <Grid>
                            <Grid x:Name="PageContainer">
                                <!-- The welcome page -->
                                <Grid x:Name="WelcomePage"
                                      anim:Animate.Appear="{StaticResource PageAnimation_OnAppear}" anim:Animate.Disappear="{StaticResource PageAnimation_OnDisappear}">
                                    <Grid x:Name="Particles" IsHitTestVisible="False"
                                          anim:Animate.Appear="{anim:Zoom From=0.5, StartAfter=0.5s, Duration=1s, Easing=EaseOut}">
                                        <Ellipse Style="{StaticResource Particle}" Width="10" Height="10" Margin="30,60,0,0" />
                                        <Ellipse Style="{StaticResource Particle}" Width="6" Height="6" Margin="90,200,0,0" />
                                        <Ellipse Style="{StaticResource Particle}" Width="14" Height="14" Margin="40,300,0,0" />
                                        <Ellipse Style="{StaticResource Particle}" Width="8" Height="8" Margin="160,30,0,0" />
                                        <Ellipse Style="{StaticResource Particle}" Width="8" Height="8" Margin="0,80,40,0" HorizontalAlignment="Right" />
                                        <Ellipse Style="{StaticResource Particle}" Width="12" Height="12" Margin="0,220,90,0" HorizontalAlignment="Right" />
                                        <Ellipse Style="{StaticResource Particle}" Width="6" Height="6" Margin="0,320,30,0" HorizontalAlignment="Right" />
                                        <Ellipse Style="{StaticResource Particle}" Width="10" Height="10" Margin="0,0,0,24" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border x:Name="WelcomeTitle" Background="White" CornerRadius="14" Padding="24,6" Margin="16,16,16,16" HorizontalAlignment="Center"
                                                anim:Animate.Appear="{anim:Zoom From=0.5, StartAfter=0.5s, Duration=1s, Easing=Overshoot, Bounciness=1}">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="2" Color="Black" BlurRadius="18" Opacity="0.2" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="Welcome" FontSize="{Responsive Mobile=30, Tablet=38}" FontWeight="Black" HorizontalAlignment="Center">
                                                    <TextBlock.Foreground>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#5B5BD6" Offset="0" />
                                                            <GradientStop Color="#C04FD0" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                                <TextBlock x:Name="WelcomeSubtitle" Text="TO THE OPENSILVER SHOWCASE!" FontSize="7" FontWeight="Bold" CharacterSpacing="300"
                                                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"
                                                           anim:Animate.Appear="{anim:Zoom From=0.5, StartAfter=1.5s, OthersDuration=0.375s, Easing=EaseInOut, OnPageOpen=PushOthers}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="WelcomeCard" Background="White" CornerRadius="14" MaxWidth="300" Margin="20,0,20,16" Padding="18,14"
                                                anim:Animate.Appear="{anim:Zoom From=0.5, StartAfter=2.7s, Duration=1s, OthersDuration=1.5s, Easing=EaseInOut, OnPageOpen=PushOthers}">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="2" Color="Black" BlurRadius="14" Opacity="0.15" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="A hands-on learning tool for C#, XAML and OpenSilver. Explore more than 200 samples, with their source code in one click."
                                                           FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="Use the menu to start exploring!" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- A sample that loads quickly -->
                                <StackPanel x:Name="ButtonsPage" Style="{StaticResource SamplePage}">
                                    <TextBlock Text="Buttons" Style="{StaticResource SampleTitle}" />
                                    <TextBlock Text="A button runs a command when it's clicked." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                    <Border Style="{StaticResource SampleBox}">
                                        <WrapPanel>
                                            <Button Content="OK" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" />
                                        </WrapPanel>
                                    </Border>
                                    <Button Content="View source" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-8,8,0,0" Click="ViewSource_Click"
                                            Tag='&lt;Button Content="OK" /&gt;&#10;&lt;Button Content="Cancel" /&gt;' />
                                </StackPanel>

                                <!-- A sample that takes a while to load -->
                                <StackPanel x:Name="DataGridPage" Style="{StaticResource SamplePage}">
                                    <TextBlock Text="Data grid" Style="{StaticResource SampleTitle}" />
                                    <TextBlock Text="A data grid shows a list of items in rows and columns." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                    <!-- The rows are in a grid of their own, which shows when they are loaded.
                                         The last column has a fixed width, so that it lines up in both grids. -->
                                    <Border Style="{StaticResource SampleBox}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="92" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{StaticResource StageBrush}" CornerRadius="10,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="76" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Order" Style="{StaticResource OrderText}" FontWeight="SemiBold" Margin="12,8" />
                                                    <TextBlock Grid.Column="1" Text="Customer" Style="{StaticResource OrderText}" FontWeight="SemiBold" Margin="12,8" />
                                                    <TextBlock Grid.Column="2" Text="Total" Style="{StaticResource OrderText}" FontWeight="SemiBold" Margin="12,8" />
                                                </Grid>
                                            </Border>
                                            <Grid x:Name="Orders" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Top" anim:Animate.Appear="Fade">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="#1024" Style="{StaticResource OrderText}" />
                                                <TextBlock Grid.Column="1" Text="Alex Martin" Style="{StaticResource OrderText}" />
                                                <TextBlock Grid.Column="2" Text="$64.00" Style="{StaticResource OrderText}" />
                                                <TextBlock Grid.Row="1" Text="#1025" Style="{StaticResource OrderText}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Sam Lee" Style="{StaticResource OrderText}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="$18.50" Style="{StaticResource OrderText}" />
                                                <TextBlock Grid.Row="2" Text="#1026" Style="{StaticResource OrderText}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Kim Novak" Style="{StaticResource OrderText}" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="$120.00" Style="{StaticResource OrderText}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Button Content="View source" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-8,8,0,0" Click="ViewSource_Click"
                                            Tag='&lt;sdk:DataGrid ItemsSource="{Binding Orders}"&#10;              AutoGenerateColumns="True" /&gt;' />
                                </StackPanel>
                            </Grid>

                            <!-- The buttons at the top -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,12,0">
                                <Border x:Name="SuggestSamplesButton" Margin="0,0,8,0"
                                        anim:Animate.Appear="{anim:Slide From=Top, Distance=50%, StartAfter=2.3s, Duration=0.5s, Easing=EaseOut}">
                                    <Border Style="{StaticResource Tab}" anim:Animate.Hover="Nudge">
                                        <StackPanel>
                                            <TextBlock Text="Suggest" FontSize="11" FontWeight="Bold" Opacity="0.7" HorizontalAlignment="Center" />
                                            <TextBlock Text="NEW SAMPLES" Style="{StaticResource TabSmallText}" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <Border x:Name="ForkOnGitHubButton"
                                        anim:Animate.Appear="{anim:Slide From=Top, Distance=50%, StartAfter=2s, Duration=0.5s, Easing=EaseOut}">
                                    <Border Style="{StaticResource Tab}" anim:Animate.Hover="Nudge">
                                        <StackPanel>
                                            <TextBlock Text="FORK ME ON" Style="{StaticResource TabSmallText}" />
                                            <TextBlock Text="GitHub" FontSize="11" FontWeight="Bold" Opacity="0.7" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <!-- Shown while a sample loads. Its Appear is set in the code. -->
                            <Border x:Name="LoadingPopup" Visibility="Collapsed" Background="#E61C1E2B" CornerRadius="12" Padding="24,14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Foreground="White" FontSize="13" FontWeight="Bold" TextAlignment="Center">Loading<LineBreak />Please wait...</TextBlock>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <sdk:GridSplitter x:Name="GridSplitter1" Grid.Row="1" Visibility="Collapsed" Height="5" HorizontalAlignment="Stretch" Background="#D9DCE7" ShowsPreview="False" />
                <Grid x:Name="SourceCodePane" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource CodeBackgroundBrush}"
                      anim:Animate.Appear="{anim:Slide From=Bottom, Distance=100%, Fade=False, Duration=0.5s, Easing=EaseOut}"
                      anim:Animate.Disappear="{anim:Slide To=Bottom, Distance=100%, Fade=False, Duration=0.5s, Easing=EaseIn}">
                    <TextBlock x:Name="SourceCode" Style="{StaticResource CodeText}" Margin="16,12,44,12" />
                    <Button x:Name="ButtonToCloseSourceCode" Content="×" Style="{StaticResource IconButton}" FontSize="18" Padding="10,2,10,4" Margin="4"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="ButtonToCloseSourceCode_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
