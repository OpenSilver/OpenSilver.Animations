<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.MovesAndResizesChapter"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="Smooth moves and resizes">

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 3" Style="{StaticResource OverlineText}" />
        <TextBlock Text="Smooth moves and resizes" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Set Animate.MoveAndResize to Smooth on an element, and whenever it moves or changes size, it glides there instead of jumping. Everything that moves because of the same change glides with it, with the same timing, so nothing ever overlaps." />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Turn on Show what animates to see what moves together: the element where the change started is outlined in orange, and the elements that move with it in pink." />

        <!-- 1. Save button -->
        <controls:DemoCard Title="A button whose label changes"
                           Description="Click Save. The label gets longer, the button widens, and the buttons to its right slide over, although they have no setting."
                           Xaml='&lt;Button Content="Save" anim:Animate.MoveAndResize="Smooth" /&gt;'
                           Expectations="• The Save button widens smoothly when its label becomes &quot;Saving...&quot;, then shrinks back.&#10;• Preview and Share slide at the same pace, and never overlap the Save button.">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" anim:Animate.MoveAndResize="Smooth" Click="SaveButton_Click" />
                <Button Content="Preview" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                <Button Content="Share" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 2. Badge -->
        <controls:DemoCard Title="A badge with a count"
                           Description="The count goes from 3 to 12 to 128. The badge grows around the number, and the tabs next to it make room."
                           Xaml='&lt;Border x:Name="Badge" CornerRadius="10" anim:Animate.MoveAndResize="Smooth"&gt;&#10;    &lt;TextBlock Text="{Binding UnreadCount}" /&gt;&#10;&lt;/Border&gt;'
                           Expectations="• The badge widens and narrows smoothly.&#10;• The Archive and Spam tabs slide with it.">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Card}" Padding="14,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Inbox" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border x:Name="Badge" Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="7,2" Margin="8,0,0,0" MinWidth="22"
                                    VerticalAlignment="Center" anim:Animate.MoveAndResize="Smooth">
                                <TextBlock x:Name="BadgeCount" Text="3" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,9" Margin="8,0,0,0">
                        <TextBlock Text="Archive" />
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,9" Margin="8,0,0,0">
                        <TextBlock Text="Spam" />
                    </Border>
                </StackPanel>
                <Button Content="New messages" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="NewMessages_Click" />
            </StackPanel>
        </controls:DemoCard>

        <TextBlock Text="Everything inside a container" Style="{StaticResource HeadingText}" FontSize="22" Margin="0,16,0,6" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Setting MoveAndResize on every element of a form gets tedious. Set it once on a container, with ApplyTo=EverythingInside, and every element inside it, at any depth, moves and resizes smoothly. That includes the parts of templates and the elements added later." />

        <!-- 3. Settings form -->
        <controls:DemoCard Title="A settings form"
                           Description="Turn the options on and off. Each one shows or hides a few more settings. Everything below them makes room, and the new settings are revealed as the room opens up, or hidden as it closes, although only the form has a setting."
                           Xaml='&lt;Border anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}"&gt;&#10;    &lt;!-- The options, their extra settings, and the Save button --&gt;&#10;&lt;/Border&gt;'
                           Expectations="• The options and the Save button below slide down to make room, and the extra settings are revealed from the top at the same pace, without overlapping them.&#10;• When they are hidden, they are wiped out from the bottom up while everything below slides back up, without overlapping them.&#10;• Turning several options on and off quickly never makes anything jump.">
            <Border x:Name="SettingsForm" Style="{StaticResource Card}" Padding="{Responsive Mobile=14, Tablet=20}" MaxWidth="520" HorizontalAlignment="Left"
                    anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}">
                <StackPanel x:Name="FormFields">
                    <TextBlock Text="Account settings" Style="{StaticResource HeadingText}" FontSize="16" />

                    <CheckBox x:Name="EmailOption" Content="Email me about activity" Style="{StaticResource SwitchCheckBox}" Margin="-8,12,0,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <StackPanel x:Name="EmailDetails" Margin="38,4,0,4" Visibility="Collapsed">
                        <RadioButton Content="Every time something happens" GroupName="EmailFrequency" IsChecked="True" Margin="0,4,0,0" />
                        <RadioButton Content="Once a day, in a summary" GroupName="EmailFrequency" Margin="0,6,0,0" />
                        <RadioButton Content="Once a week, in a summary" GroupName="EmailFrequency" Margin="0,6,0,0" />
                    </StackPanel>

                    <CheckBox x:Name="TwoStepOption" Content="Two-step sign-in" Style="{StaticResource SwitchCheckBox}" Margin="-8,8,0,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <StackPanel x:Name="TwoStepDetails" Margin="38,4,0,4" Visibility="Collapsed">
                        <TextBlock Text="Phone number" Style="{StaticResource CaptionText}" />
                        <TextBox Width="{Responsive Mobile=180, Tablet=220}" HorizontalAlignment="Left" Margin="0,4,0,0" Text="+1 555 0100" />
                        <TextBlock Text="We will send a code to this number each time you sign in on a new device." Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>

                    <CheckBox x:Name="PublicOption" Content="Public profile" Style="{StaticResource SwitchCheckBox}" Margin="-8,8,0,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <StackPanel x:Name="PublicDetails" Margin="38,4,0,4" Visibility="Collapsed">
                        <TextBlock Text="Anyone with this address can see your name, your photo and your projects:" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="opensilver.net/people/alex" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Content="Save changes" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </controls:DemoCard>

        <!-- 4. Wave -->
        <controls:DemoCard x:Name="WaveDemo" Title="Cards that move like a wave"
                           Description="The cards are in a StackPanel that has ApplyTo=EverythingInside and a Wave: the elements farther from the change start a bit later. When the first card grows, the cards below it start moving one after the other, the farthest last."
                           Xaml='&lt;StackPanel anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside, Wave=0.8, Duration=0.4s}"&gt;'
                           Expectations="• The first card grows, and the cards below follow it one after the other, like a wave.&#10;• With Wave at 0, they all move at the same time.&#10;• The content of the first card never lags behind the card.">
            <StackPanel>
                <StackPanel x:Name="WaveArea" MaxWidth="520" HorizontalAlignment="Left"
                            anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside, Wave=0.8, Duration=0.4s}">
                    <Border x:Name="GrowingCard" Style="{StaticResource Card}" Height="64" Padding="16,12" Margin="0,0,0,8" ClipToBounds="True">
                        <StackPanel>
                            <TextBlock Text="Release notes" FontWeight="SemiBold" />
                            <TextBlock Text="Version 3.4 brings faster layout and the new animations library." Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                            <TextBlock Text="It also improves the way text is measured, so that pages appear sooner, and it fixes forty bugs reported by the community. Thank you for them!" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Invoices" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Team calendar" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Design reviews" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Support tickets" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Archived projects" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0">
                        <TextBlock Text="Trash" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="GrowButton" Content="Show the release notes" Style="{StaticResource SecondaryButton}" Click="Grow_Click" />
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="340" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wave" Style="{StaticResource SliderLabel}" />
                    <Slider x:Name="WaveSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="0.8" SmallChange="0.1" LargeChange="0.1"
                            ValueChanged="WaveSlider_ValueChanged" />
                    <TextBlock x:Name="WaveText" Grid.Column="2" Text="0.8" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </StackPanel>
        </controls:DemoCard>

        <TextBlock Text="Layouts that switch while you drag" Style="{StaticResource HeadingText}" FontSize="22" Margin="0,16,0,6" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="A layout that switches with {Responsive} needs nothing more. When the panel that a {Responsive} value watches crosses a breakpoint, the switch is a change, like a click: what it rearranges animates with the nearest setting, while everything else keeps following your hand." />

        <!-- 5. A {Responsive} switch while a panel is resized -->
        <controls:DemoCard Title="A panel that you resize"
                           Description="Drag the handle on the right of the profile. Its content uses {Responsive} with ElementName=ProfilePanel: from 220 pixels wide, the photo goes beside the name and the buttons side by side. The panel has ApplyTo=EverythingInside."
                           Xaml='&lt;Border x:Name="ProfilePanel" anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}"&gt;&#10;    &lt;StackPanel Orientation="{Responsive ElementName=ProfilePanel, Threshold=220,&#10;                                          Mobile=Vertical, Desktop=Horizontal}"&gt;'
                           Expectations="• While you drag, the panel and the page next to it follow the pointer exactly.&#10;• When the panel crosses 220 pixels, the photo, the name and the buttons glide to their new places, even though you keep dragging.&#10;• Switch the layout from code: the panel also glides to its new width, because a click is not a resize.">
            <StackPanel>
                <Grid x:Name="ProfileGrid" Height="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProfileColumn" Width="170" MinWidth="130" MaxWidth="420" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="24" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ProfilePanel" Style="{StaticResource Card}"
                            anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}">
                        <StackPanel>
                            <StackPanel Orientation="{Responsive ElementName=ProfilePanel, Threshold=220, Mobile=Vertical, Desktop=Horizontal}">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="AL" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="{Responsive ElementName=ProfilePanel, Threshold=220, Mobile='0,10,0,0', Desktop='12,0,0,0'}" VerticalAlignment="Center">
                                    <TextBlock Text="Ada Lovelace" FontWeight="SemiBold" />
                                    <TextBlock Text="Analyst" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="{Responsive ElementName=ProfilePanel, Threshold=220, Mobile=Vertical, Desktop=Horizontal}" Margin="0,16,0,0">
                                <Button Content="Follow" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Message" Style="{StaticResource SecondaryButton}"
                                        Margin="{Responsive ElementName=ProfilePanel, Threshold=220, Mobile='0,8,0,0', Desktop='8,0,0,0'}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <sdk:GridSplitter Grid.Column="1" Width="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False" />
                    <Border Grid.Column="1" Width="4" Height="40" CornerRadius="2" Background="#C9CCD8" IsHitTestVisible="False" />
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <TextBlock Text="The rest of the page" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
                <Button Content="Switch the layout from code" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SwitchProfile_Click" />
            </StackPanel>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Only the element that changes needs a setting. Its neighbors and containers move in the same change, so they animate with it, with its duration and curve. Use {anim:Smooth Duration=0.4s, Easing=Gentle} to change the timing." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Nothing is copied to the elements inside an area: when something changes, the library looks up the containers of the element where the change started. Keep areas small: on a whole page, every size change animates, which is rarely what you want." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Wave goes from 0 to 2. At 1, an element starts at most 0.2 s after the change, when it is 600 pixels away or more; at 2, 0.4 s. What is inside an element always moves with it. A wave can make elements overlap for a moment: use it for small, playful moves." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• A {Responsive} switch keeps animating while you keep dragging: what stretches with the panel follows it at once, and what the switch moved glides on top of that. It works the same when the window is resized, as chapter 12 shows." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Chapter 7 has more of them: a layout that goes from two columns to one, a bouncy underline, a sidebar, a dialog, an image that loads, and a live chart that is left out." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="3" />
    </StackPanel>
</sdk:Page>
