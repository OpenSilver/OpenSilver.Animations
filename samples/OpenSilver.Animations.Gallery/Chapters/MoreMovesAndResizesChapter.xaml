<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.MoreMovesAndResizesChapter"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="More moves and resizes">

    <sdk:Page.Resources>
        <!-- On phones, the columns are narrow: the icon goes above the text -->
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="{Responsive Mobile=12, Tablet=16}" />
        </Style>
        <Style x:Key="SettingCardText" TargetType="StackPanel">
            <Setter Property="Margin" Value="{Responsive Mobile='0,44,0,0', Tablet='50,0,0,0'}" />
        </Style>
        <!-- The widths when expanded or not focused; the code sets the other width and clears it to come back -->
        <Style x:Key="DemoSidebarStyle" TargetType="Border">
            <Setter Property="Width" Value="{Responsive Mobile=150, Tablet=240}" />
        </Style>
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="{Responsive Mobile=100, Tablet=180}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9DCE7" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </sdk:Page.Resources>

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 7" Style="{StaticResource OverlineText}" />
        <TextBlock Text="More moves and resizes" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Chapter 3 showed MoveAndResize on one element and on a whole container. Here are more of the changes that apps make every day: columns that change, a tab underline, a sidebar, a dialog, an image that loads, a search box, and a live chart that should not glide." />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Smooth is right most of the time. Bouncy adds character: it overshoots a little and settles, like a spring." />

        <!-- 1. Two columns to one -->
        <controls:DemoCard Title="A layout that goes from two columns to one"
                           Description="The four cards are in a Grid that has ApplyTo=EverythingInside. The button moves them to a single column. None of the cards has a setting of its own, and all of them glide."
                           Xaml='&lt;Grid anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}"&gt;'
                           Expectations="• Each card glides to its new place and width, all at the same pace.&#10;• The text inside the cards re-wraps to the new width as the cards resize.&#10;• The demos below slide down or up with them.">
            <StackPanel>
                <Grid x:Name="ResponsiveGrid" anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ProfileCard" Style="{StaticResource SettingCard}">
                        <Grid>
                            <Border Width="36" Height="36" CornerRadius="10" Background="#E3E3FB" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="P" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Style="{StaticResource SettingCardText}">
                                <TextBlock Text="Profile" FontWeight="SemiBold" />
                                <TextBlock Text="Your name, your photo, and the way other people see you." Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="NotificationsCard" Style="{StaticResource SettingCard}">
                        <Grid>
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FDEBD8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="N" FontWeight="Bold" Foreground="#C2620E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Style="{StaticResource SettingCardText}">
                                <TextBlock Text="Notifications" FontWeight="SemiBold" />
                                <TextBlock Text="Choose what reaches you, and when." Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="BillingCard" Style="{StaticResource SettingCard}">
                        <Grid>
                            <Border Width="36" Height="36" CornerRadius="10" Background="#DDF3E6" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="B" FontWeight="Bold" Foreground="#1F8A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Style="{StaticResource SettingCardText}">
                                <TextBlock Text="Billing" FontWeight="SemiBold" />
                                <TextBlock Text="Your plan, your invoices and the ways you pay." Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="TeamCard" Style="{StaticResource SettingCard}">
                        <Grid>
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FBE1EC" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="T" FontWeight="Bold" Foreground="#B8326B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Style="{StaticResource SettingCardText}">
                                <TextBlock Text="Team" FontWeight="SemiBold" />
                                <TextBlock Text="Invite people and choose what each of them can do." Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Button x:Name="ColumnsButton" Content="Switch to one column" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="ColumnsButton_Click" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 2. Bouncy tab underline -->
        <controls:DemoCard x:Name="BouncyDemo" Title="A tab underline that bounces"
                           Description="Click the tabs. The underline is in the Grid column of the selected tab: changing its Grid.Column moves it and changes its width, and Bouncy makes it overshoot a little before it settles."
                           Xaml='&lt;Border x:Name="Underline" Grid.Row="1" Height="3" anim:Animate.MoveAndResize="Bouncy" /&gt;'
                           Expectations="• The underline slides to the tab you click, overshoots a little, and settles.&#10;• Its width changes smoothly, without bouncing, so it never wobbles.&#10;• With more bounciness, it overshoots more.">
            <StackPanel>
                <Grid x:Name="Tabs" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Content="Overview" Style="{StaticResource TabButton}" Tag="0" Click="Tab_Click" />
                    <Button Grid.Column="1" Content="Activity" Style="{StaticResource TabButton}" Tag="1" Click="Tab_Click" />
                    <Button Grid.Column="2" Content="Team" Style="{StaticResource TabButton}" Tag="2" Click="Tab_Click" />
                    <Button Grid.Column="3" Content="Settings" Style="{StaticResource TabButton}" Tag="3" Click="Tab_Click" />
                    <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="{StaticResource LineBrush}" VerticalAlignment="Bottom" />
                    <Border x:Name="Underline" Grid.Row="1" Height="3" CornerRadius="1.5" Margin="{Responsive Mobile='6,0', Tablet='10,0'}" Background="{StaticResource AccentBrush}"
                            anim:Animate.MoveAndResize="Bouncy" />
                </Grid>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="340" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bounciness" Style="{StaticResource SliderLabel}" />
                    <Slider x:Name="BouncinessSlider" Grid.Column="1" Minimum="0.1" Maximum="1" Value="0.5" SmallChange="0.1" LargeChange="0.1"
                            ValueChanged="BouncySettings_Changed" />
                    <TextBlock x:Name="BouncinessText" Grid.Column="2" Text="0.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="1" Text="Duration" Style="{StaticResource SliderLabel}" Margin="0,8,0,0" />
                    <Slider x:Name="BouncyDurationSlider" Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="1.5" Value="0.5" SmallChange="0.1" LargeChange="0.1" Margin="0,8,0,0"
                            ValueChanged="BouncySettings_Changed" />
                    <TextBlock x:Name="BouncyDurationText" Grid.Row="1" Grid.Column="2" Text="0.5 s" VerticalAlignment="Center" Margin="12,8,0,0" />
                </Grid>
            </StackPanel>
        </controls:DemoCard>

        <!-- 3. Sidebar -->
        <controls:DemoCard Title="A sidebar that collapses"
                           Description="The sidebar narrows to 64 pixels, leaving only its icons. The content area next to it fills the space with the same timing."
                           Xaml='&lt;Border x:Name="Sidebar" Width="240" ClipToBounds="True" anim:Animate.MoveAndResize="Smooth"&gt;'
                           Expectations="• The sidebar narrows and widens smoothly; the labels are revealed or hidden by its edge.&#10;• The content area grows and shrinks in sync, with no gap and no overlap.">
            <StackPanel>
                <Grid MinHeight="220">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DemoSidebar" Style="{StaticResource DemoSidebarStyle}" Background="{StaticResource DarkPanelBrush}" CornerRadius="10" ClipToBounds="True"
                            anim:Animate.MoveAndResize="Smooth">
                        <StackPanel Margin="14">
                            <Grid Margin="0,0,0,10">
                                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="H" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Home" Foreground="White" FontWeight="SemiBold" Margin="50,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Border Width="36" Height="36" CornerRadius="9" Background="#3DFFFFFF" HorizontalAlignment="Left">
                                    <TextBlock Text="I" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Inbox" Foreground="#D0D3E8" Margin="50,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Border Width="36" Height="36" CornerRadius="9" Background="#3DFFFFFF" HorizontalAlignment="Left">
                                    <TextBlock Text="R" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Reports" Foreground="#D0D3E8" Margin="50,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Border Width="36" Height="36" CornerRadius="9" Background="#3DFFFFFF" HorizontalAlignment="Left">
                                    <TextBlock Text="S" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Settings" Foreground="#D0D3E8" Margin="50,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="{Responsive Mobile=12, Tablet=20}">
                        <StackPanel>
                            <TextBlock Text="Dashboard" Style="{StaticResource HeadingText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,14"
                                       Text="This area takes the rest of the row. It has no setting, and still follows the sidebar." />
                            <Border Height="10" CornerRadius="5" Background="{StaticResource AccentLightBrush}" />
                            <Border Height="10" CornerRadius="5" Background="{StaticResource AccentLightBrush}" Margin="{Responsive Mobile='0,10,25,0', Tablet='0,10,60,0'}" />
                            <Border Height="10" CornerRadius="5" Background="{StaticResource AccentLightBrush}" Margin="{Responsive Mobile='0,10,50,0', Tablet='0,10,120,0'}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Button x:Name="SidebarButton" Content="Collapse the sidebar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SidebarButton_Click" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 4. ChildWindow -->
        <controls:DemoCard Title="A dialog that gets wider"
                           Description="Open the dialog, then make it wider. It grows from 300 to 600 pixels, or to the width of a small screen, and stays centered, and its content stretches with it."
                           Xaml='&lt;ChildWindow Width="300" anim:Animate.MoveAndResize="Smooth"&gt;'
                           Expectations="• The dialog grows and shrinks smoothly, and stays centered while it does.&#10;• The text box inside stretches in sync and never sticks out of the dialog.">
            <Button Content="Open the dialog" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OpenDialog_Click" />
        </controls:DemoCard>

        <!-- 5. Image -->
        <controls:DemoCard Title="A card whose image loads"
                           Description="The photo arrives a moment after the card. Instead of jumping, the card grows to make room, and the text below slides down."
                           Xaml='&lt;Border x:Name="PhotoCard" anim:Animate.MoveAndResize="Smooth"&gt;&#10;    &lt;Image Source="{Binding PhotoUrl}" /&gt;&#10;&lt;/Border&gt;'
                           Expectations="• When the photo loads, the card grows smoothly and the text below it slides down.&#10;• When the photo is removed, the card shrinks back smoothly.">
            <StackPanel HorizontalAlignment="Left">
                <Border x:Name="PhotoCard" Style="{StaticResource Card}" Width="280" Padding="12" HorizontalAlignment="Left" anim:Animate.MoveAndResize="Smooth">
                    <StackPanel>
                        <Image x:Name="Photo" Stretch="Uniform" />
                        <TextBlock Text="Evening in the hills" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Photo by the OpenSilver team" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="The rest of the page is below the card." Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                <Button x:Name="PhotoButton" Content="Load the photo" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="PhotoButton_Click" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 6. Search box -->
        <controls:DemoCard Title="A search box that widens on focus"
                           Description="Click in the search box. It widens, and the buttons next to it slide. Typing inside it never animates."
                           Xaml='&lt;TextBox Width="180" GotFocus="Widen" LostFocus="Narrow" anim:Animate.MoveAndResize="Smooth" /&gt;'
                           Expectations="• The search box widens smoothly when it gets the focus, and narrows when it loses it.&#10;• Filters and Sort slide with it.">
            <StackPanel x:Name="SearchRow" Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}" VerticalAlignment="Center" anim:Animate.MoveAndResize="Smooth"
                         GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" />
                <Button x:Name="FiltersButton" Content="Filters" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                <Button x:Name="SortButton" Content="Sort" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 7. Carving out with None -->
        <controls:DemoCard x:Name="CarveOutDemo" Title="Leaving a live chart out"
                           Description="This dashboard has ApplyTo=EverythingInside, but its chart updates often and should not glide. MoveAndResize=None on the chart leaves it, and everything inside it, out of the area."
                           Xaml='&lt;Border anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}"&gt;&#10;    &lt;!-- The numbers animate --&gt;&#10;    &lt;Grid x:Name="Chart" anim:Animate.MoveAndResize="None"&gt;&#10;        &lt;!-- The bars snap --&gt;&#10;    &lt;/Grid&gt;&#10;&lt;/Border&gt;'
                           Expectations="• With the chart left out, Refresh makes the number cards resize smoothly as their numbers get much longer or shorter, the cards next to them slide along, and the bars jump to their new heights.&#10;• Turn the switch off and refresh again: now the bars glide too.">
            <StackPanel>
                <Border x:Name="Dashboard" Style="{StaticResource Card}" Padding="{Responsive Mobile=12, Tablet=20}" anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}">
                    <StackPanel>
                        <WrapPanel>
                            <Border Background="{StaticResource StageBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Visitors" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="VisitorsText" Text="1,204" FontSize="22" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource StageBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Sign-ups" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="SignUpsText" Text="86" FontSize="22" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource StageBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Conversion" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="ConversionText" Text="7.1%" FontSize="22" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <Grid x:Name="Chart" Height="140" Margin="0,6,0,0" anim:Animate.MoveAndResize="None">
                            <Border Height="1" Background="{StaticResource LineBrush}" VerticalAlignment="Bottom" />
                            <!-- One star column per bar, so that the bars share the width of the chart -->
                            <Grid x:Name="Bars" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,16,0,0">
                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Click="Refresh_Click" />
                    <CheckBox x:Name="CarveOutSwitch" Content="Leave the chart out (None)" Style="{StaticResource SwitchCheckBox}" IsChecked="True"
                              VerticalAlignment="Center" Checked="CarveOut_Changed" Unchecked="CarveOut_Changed" />
                </WrapPanel>
            </StackPanel>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The nearest setting wins. Starting from the element that changed, the library goes up and takes the first EverythingInside, or the first setting of an element that moves or changes size because of the change. Everything the change moves uses that timing. For example, in a Smooth dashboard, a card with {anim:Bouncy} bounces when its content makes it grow, and so do the cards it pushes. When something else pushes it, it moves smoothly with the rest." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Bouncy lasts twice as long as Smooth by default (0.5 s), so that the bounce has time to settle. A bounce goes past the end, so it can make elements overlap for a moment: use it for small, playful moves." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Popups are boundaries: a drop-down, a tooltip or a ChildWindow opened from inside an area is not part of it. Set MoveAndResize on the ChildWindow itself, like the dialog above." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="7" />
    </StackPanel>
</sdk:Page>
