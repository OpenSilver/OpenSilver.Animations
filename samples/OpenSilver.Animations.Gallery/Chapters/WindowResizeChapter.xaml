<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.WindowResizeChapter"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="When the window is resized"
          SizeChanged="Page_SizeChanged">

    <!-- This chapter uses the whole width of the window, so that resizing the window changes it. -->
    <StackPanel Style="{StaticResource ChapterRoot}" MaxWidth="100000">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="CHAPTER 12" Style="{StaticResource OverlineText}" />
            <TextBlock Text="When the window is resized" Style="{StaticResource ChapterTitleText}" />
            <TextBlock Style="{StaticResource IntroText}"
                       Text="When the browser window is resized, nothing animates by default, even elements that have MoveAndResize. A page that follows the edge of the window with a delay feels slow, and it costs a lot." />
            <TextBlock Style="{StaticResource IntroText}"
                       Text="For the few elements that should glide, like a grid of photos, add AlsoOnWindowResize=True. They follow the window, together with what is inside them, and the rest of the page snaps." />
            <TextBlock Style="{StaticResource IntroText}"
                       Text="A layout that switches with {Responsive} needs nothing more. When the window crosses a breakpoint, the switch is a change, like a click: what it rearranges animates with the nearest setting, while everything else keeps following your hand. Chapter 3 shows the same with a panel that you resize." />
        </StackPanel>

        <Border Style="{StaticResource TipBox}" Margin="0,4,0,24" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextBrush}"
                       Text="Try it: make your browser window narrower and wider. This chapter uses the whole width of the window, so the tiles below change rows as you go." />
        </Border>

        <!-- 1. With AlsoOnWindowResize -->
        <controls:DemoCard Title="Tiles that follow the window"
                           Description="A WrapPanel whose tiles have ItemsMoveAndResize with AlsoOnWindowResize=True. When a row gets too narrow, its last tile glides to the next row."
                           Xaml='&lt;WrapPanel anim:Animate.ItemsMoveAndResize="{anim:Smooth AlsoOnWindowResize=True}"&gt;'
                           Expectations="• While you resize the window, the tiles glide to their new places, and keep following it.&#10;• The card around them snaps to its new size, so tiles can stick out of it for a moment.">
            <WrapPanel x:Name="FollowingTiles"
                       anim:Animate.ItemsMoveAndResize="{anim:Smooth AlsoOnWindowResize=True}" />
        </controls:DemoCard>

        <!-- 2. Without -->
        <controls:DemoCard Title="Tiles that don't"
                           Description="The same WrapPanel, with ItemsMoveAndResize but without AlsoOnWindowResize. Changes of the tiles themselves still animate: click a tile to make it wider."
                           Xaml='&lt;WrapPanel anim:Animate.ItemsMoveAndResize="Smooth"&gt;'
                           Expectations="• While you resize the window, the tiles jump to their new places.&#10;• When you click a tile, it widens smoothly and the tiles after it glide, because the change came from a tile, not from the window.">
            <WrapPanel x:Name="SnappingTiles"
                       anim:Animate.ItemsMoveAndResize="Smooth" />
        </controls:DemoCard>

        <!-- 3. A {Responsive} switch while the window is resized -->
        <controls:DemoCard Title="A layout that switches with the window" MaxWidth="920" HorizontalAlignment="Left"
                           Description="Three steps in a StackPanel with ApplyTo=EverythingInside, whose Orientation comes from {Responsive} with Threshold=1100: side by side when the window is at least 1100 pixels wide, one below the other when it is narrower. The panel has no AlsoOnWindowResize."
                           Xaml='&lt;StackPanel Orientation="{Responsive Threshold=1100, Mobile=Vertical, Desktop=Horizontal}"&#10;            anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}"&gt;'
                           Expectations="• Make the window narrower and wider across 1100 pixels: the steps glide between a row and a column, while you keep resizing.&#10;• At other widths, nothing in this demo moves.&#10;• The card around the steps snaps to its new height, so steps can stick out of it for a moment.">
            <StackPanel>
                <TextBlock x:Name="WindowWidthText" Style="{StaticResource CaptionText}" Margin="0,0,0,12" />
                <StackPanel Orientation="{Responsive Threshold=1100, Mobile=Vertical, Desktop=Horizontal}" HorizontalAlignment="Left"
                            anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}">
                    <Border Style="{StaticResource Card}" Width="200" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="1. Pick a photo" FontWeight="SemiBold" />
                            <TextBlock Text="From your device or the web." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Width="200" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="2. Crop it" FontWeight="SemiBold" />
                            <TextBlock Text="Drag the corners." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Width="200" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="3. Share it" FontWeight="SemiBold" />
                            <TextBlock Text="With a link or by email." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}" HorizontalAlignment="Left" MaxWidth="920">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Each time the window size changes, the tiles start again from where they are on screen, so they never jump back." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• AlsoOnWindowResize also works on a single element, for example {anim:Smooth AlsoOnWindowResize=True} on a side panel that changes width with the window." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• A {Responsive} switch animates whether it watches the window, an element named with ElementName, or one found with RelativeSource. It animates with the setting found going up from the element it applies to, like the ApplyTo=EverythingInside of the steps, and only inside it: the rest of the page snaps, because it follows the resize." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The switch keeps animating while you keep resizing: what stretches with the window follows it at once, and what the switch moved glides on top of that." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="12" />
    </StackPanel>
</sdk:Page>
