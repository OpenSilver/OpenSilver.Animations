<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.FirstAnimationChapter"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="Your first animation">

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 1" Style="{StaticResource OverlineText}" />
        <TextBlock Text="Your first animation" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Set Animate.Appear and Animate.Disappear on an element. When it is shown, hidden, added or removed, it fades in or out instead of popping, and the elements around it make room or fill the space smoothly, with the same timing. They need no setting of their own." />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Your code doesn't change: you still set Visibility, or add and remove elements. The library notices it and animates what changed." />

        <!-- 1. Details panel -->
        <controls:DemoCard Title="A panel that shows more details"
                           Description="Click Show details. The details fade in, and the payment and delivery rows below slide down to make room for them. Click again to hide them."
                           Xaml='&lt;StackPanel x:Name="Details" Visibility="Collapsed"&#10;            anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade"&gt;'
                           Expectations="• The details fade in while the rows below slide down, at the same pace.&#10;• When they are hidden, they fade out while the rows below slide back up.&#10;• Click quickly several times: nothing jumps, each change goes on from where the previous one was.">
            <Border Style="{StaticResource Card}" Width="{Responsive Mobile=NaN, Tablet=400}" HorizontalAlignment="{Responsive Mobile=Stretch, Tablet=Left}" Padding="{Responsive Mobile=14, Tablet=18}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Order #1042" Style="{StaticResource HeadingText}" FontSize="16" />
                            <TextBlock Text="3 items · $86.40" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="DetailsButton" Grid.Column="1" Content="Show details" Style="{StaticResource SecondaryButton}" Margin="32,0,0,0" VerticalAlignment="Center"
                                Click="DetailsButton_Click" />
                    </Grid>

                    <StackPanel x:Name="Details" Margin="0,14,0,0" Visibility="Collapsed"
                                anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Wireless headphones" Style="{StaticResource BodyText}" />
                            <TextBlock Grid.Column="1" Text="$59.00" Style="{StaticResource BodyText}" Margin="24,0,0,0" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Charging cable" Style="{StaticResource BodyText}" />
                            <TextBlock Grid.Column="1" Text="$12.40" Style="{StaticResource BodyText}" Margin="24,0,0,0" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Carrying case" Style="{StaticResource BodyText}" />
                            <TextBlock Grid.Column="1" Text="$15.00" Style="{StaticResource BodyText}" Margin="24,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Payment" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="Card ending in 4242" Style="{StaticResource BodyText}" Margin="24,0,0,0" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Delivery" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="Tomorrow, before noon" Style="{StaticResource BodyText}" Margin="24,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </controls:DemoCard>

        <!-- 2. Adding and removing -->
        <controls:DemoCard Title="Elements that are added and removed"
                           Description="Add a few notes, then remove some with their × button. Each note fades in when it is added, and fades out when it is removed, while the notes after it slide into place."
                           Xaml='&lt;!-- Each note --&gt;&#10;&lt;Border anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade"&gt;'
                           Expectations="• A new note fades in at the end, and the counter below slides down to make room.&#10;• A removed note fades out where it was, and the notes after it slide up into its place.&#10;• The two first notes faded in when the page opened, in their place: elements that are on the page from the start play their Appear when it opens.">
            <StackPanel Width="{Responsive Mobile=NaN, Tablet=400}" HorizontalAlignment="{Responsive Mobile=Stretch, Tablet=Left}">
                <StackPanel x:Name="Notes">
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8" anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                        <Grid>
                            <TextBlock Text="Call the plumber back" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,40,0" />
                            <Button Content="×" Style="{StaticResource LinkButton}" FontSize="16" HorizontalAlignment="Right" Click="RemoveNote_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8" anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                        <Grid>
                            <TextBlock Text="Book the train tickets" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,40,0" />
                            <Button Content="×" Style="{StaticResource LinkButton}" FontSize="16" HorizontalAlignment="Right" Click="RemoveNote_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="NoteCount" Text="2 notes" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                <Button Content="Add a note" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddNote_Click" />
            </StackPanel>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Appear plays when the element becomes visible, or is added to the page. Disappear plays when it becomes Collapsed or Hidden, or is removed." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• As soon as you hide or remove it, the element is gone for your code and for the mouse: what you see fading out is a copy of it." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The elements around it take the duration of the effect, a quarter of a second by default. Chapter 9 shows the other effects, like Slide, Pop and Zoom, and how to change their duration." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="1" />
    </StackPanel>
</sdk:Page>
