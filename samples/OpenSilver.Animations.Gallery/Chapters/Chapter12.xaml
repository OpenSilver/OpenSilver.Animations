<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.Chapter12"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="Hover and press">

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 12" Style="{StaticResource OverlineText}" />
        <TextBlock Text="Hover and press" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Hover says what an element does while the mouse is over it, and Press what it does while it is pressed. Elements that react a little feel alive and tell people what they can click. Nothing else moves: the element keeps its place and its size." />

        <!-- 1. Buttons -->
        <controls:DemoCard Title="Buttons that react"
                           Description="Move the mouse over these buttons, then press them. Grow makes an element a little bigger, Lift raises it, and Shrink makes it a little smaller, like a button pushed in."
                           Xaml='&lt;Button Content="Buy now" anim:Animate.Hover="Grow" anim:Animate.Press="Shrink" /&gt;&#10;&lt;Button Content="Save" anim:Animate.Hover="Lift" /&gt;&#10;&lt;Button Content="Cancel" anim:Animate.Press="Shrink" /&gt;&#10;&#10;&lt;!-- With parameters --&gt;&#10;&lt;Button Content="Bouncy" anim:Animate.Hover="{anim:Grow Zoom=1.1, Easing=Bouncy}" /&gt;'
                           Expectations="• Buy now grows while the mouse is over it, and shrinks back a little while you press it.&#10;• Save rises a little. Cancel only reacts when you press it.&#10;• Bouncy grows more, overshoots and settles.&#10;• The other buttons never move.">
            <WrapPanel>
                <Button Content="Buy now" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12"
                        anim:Animate.Hover="Grow" anim:Animate.Press="Shrink" />
                <Button Content="Save" Style="{StaticResource SecondaryButton}" Margin="0,0,12,12"
                        anim:Animate.Hover="Lift" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,12,12"
                        anim:Animate.Press="Shrink" />
                <Button Content="Bouncy" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12"
                        anim:Animate.Hover="{anim:Grow Zoom=1.1, Easing=Bouncy}" anim:Animate.Press="Shrink" />
            </WrapPanel>
        </controls:DemoCard>

        <!-- 2. Cards -->
        <controls:DemoCard Title="Cards that lift"
                           Description="Any element can react, not only buttons. These cards rise when the mouse is over them, and sink back a little when you press them."
                           Xaml='&lt;Border Style="{StaticResource Card}"&#10;        anim:Animate.Hover="{anim:Lift Distance=6}" anim:Animate.Press="Shrink"&gt;'
                           Expectations="• A card rises while the mouse is over it, and comes down when the mouse leaves.&#10;• Move the mouse slowly along the bottom edge of a card: it stays up, it doesn't go up and down.&#10;• On a touch screen, cards only react when you press them.">
            <WrapPanel Margin="0,8,0,0">
                <Border Style="{StaticResource Card}" Width="{Responsive Mobile=NaN, Tablet=200}" Margin="0,0,12,12"
                        anim:Animate.Hover="{anim:Lift Distance=6}" anim:Animate.Press="Shrink">
                    <StackPanel>
                        <TextBlock Text="Invoices" FontWeight="SemiBold" />
                        <TextBlock Text="12 waiting for payment" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="{Responsive Mobile=NaN, Tablet=200}" Margin="0,0,12,12"
                        anim:Animate.Hover="{anim:Lift Distance=6}" anim:Animate.Press="Shrink">
                    <StackPanel>
                        <TextBlock Text="Team calendar" FontWeight="SemiBold" />
                        <TextBlock Text="3 meetings today" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="{Responsive Mobile=NaN, Tablet=200}" Margin="0,0,12,12"
                        anim:Animate.Hover="{anim:Lift Distance=6}" anim:Animate.Press="Shrink">
                    <StackPanel>
                        <TextBlock Text="Support tickets" FontWeight="SemiBold" />
                        <TextBlock Text="All answered" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </controls:DemoCard>

        <!-- 3. Nudge -->
        <controls:DemoCard Title="Icons that the mouse nudges"
                           Description="Sweep the mouse quickly across these icons. Each one is pushed a little in the direction the mouse goes, turns a little if the mouse comes near a corner, and springs back. The faster the mouse, the more it moves."
                           Xaml='&lt;Border anim:Animate.Hover="Nudge" /&gt;&#10;&#10;&lt;!-- With parameters --&gt;&#10;&lt;Border anim:Animate.Hover="{anim:Nudge Distance=6, Tilt=5}" /&gt;'
                           Expectations="• A fast sweep pushes each icon in the direction of the mouse; a slow one barely moves them.&#10;• Each icon springs back past its place, and settles.&#10;• Move the sliders for a stronger push and more turn.">
            <StackPanel>
                <WrapPanel x:Name="NudgeIcons">
                    <Border Width="64" Height="64" CornerRadius="16" Background="#5B5BD6" Margin="0,0,16,16" anim:Animate.Hover="Nudge">
                        <TextBlock Text="M" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="64" Height="64" CornerRadius="16" Background="#E07A1F" Margin="0,0,16,16" anim:Animate.Hover="Nudge">
                        <TextBlock Text="C" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="64" Height="64" CornerRadius="16" Background="#239B6A" Margin="0,0,16,16" anim:Animate.Hover="Nudge">
                        <TextBlock Text="P" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="64" Height="64" CornerRadius="16" Background="#D6455B" Margin="0,0,16,16" anim:Animate.Hover="Nudge">
                        <TextBlock Text="N" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="64" Height="64" CornerRadius="16" Background="#23263A" Margin="0,0,16,16" anim:Animate.Hover="Nudge">
                        <TextBlock Text="S" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </WrapPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="340" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Distance" Style="{StaticResource SliderLabel}" />
                    <Slider x:Name="NudgeDistanceSlider" Grid.Column="1" Minimum="0" Maximum="20" Value="3" SmallChange="1" LargeChange="1"
                            ValueChanged="NudgeSettings_Changed" />
                    <TextBlock x:Name="NudgeDistanceText" Grid.Column="2" Text="3 px" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="1" Text="Tilt" Style="{StaticResource SliderLabel}" Margin="0,8,0,0" />
                    <Slider x:Name="NudgeTiltSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="15" Value="2" SmallChange="1" LargeChange="1" Margin="0,8,0,0"
                            ValueChanged="NudgeSettings_Changed" />
                    <TextBlock x:Name="NudgeTiltText" Grid.Row="1" Grid.Column="2" Text="2°" VerticalAlignment="Center" Margin="12,8,0,0" />
                </Grid>
            </StackPanel>
        </controls:DemoCard>

        <!-- 4. Disabled -->
        <controls:DemoCard Title="Disabled elements don't react"
                           Description="This button grows and shrinks like Buy now. Turn it off with the switch: while it is disabled, it doesn't react, because it can't be clicked. Then turn it on again."
                           Xaml='&lt;Button Content="Send" IsEnabled="False" anim:Animate.Hover="Grow" anim:Animate.Press="Shrink" /&gt;'
                           Expectations="• While the button is on, it grows and shrinks.&#10;• While it is off, it stays as it is, even with the mouse over it.">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SendButton" Content="Send" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        anim:Animate.Hover="Grow" anim:Animate.Press="Shrink" />
                <CheckBox x:Name="SendSwitch" Content="The button is on (IsEnabled)" Style="{StaticResource SwitchCheckBox}" IsChecked="True" VerticalAlignment="Center"
                          Margin="16,0,0,0" Checked="SendSwitch_Changed" Unchecked="SendSwitch_Changed" />
            </StackPanel>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Hover never plays on a touch screen, which has no mouse. Press works everywhere: with the mouse, a finger or a pen." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• An element reacts when the mouse is over a part of it that can be clicked. Give a Border or a Panel a Background, even Transparent, so that all of it counts." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The reaction plays on top of everything else. It doesn't change RenderTransform or any other property, so your own transforms and animations keep working, and the element can move with MoveAndResize at the same time." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Speed and Slow motion apply to it. When the device asks for reduced motion, or when animations are turned off, nothing happens." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="12" />
    </StackPanel>
</sdk:Page>
