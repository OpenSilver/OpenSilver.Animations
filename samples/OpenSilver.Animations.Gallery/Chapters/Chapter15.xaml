<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.Chapter15"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="Putting it together">

    <sdk:Page.Resources>
        <Style x:Key="WebLink" TargetType="HyperlinkButton">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TargetName" Value="_blank" />
            <Setter Property="Margin" Value="0,0,28,8" />
        </Style>
        <!-- One animation of the Showcase: what it does, its code and the chapters that explain it -->
        <Style x:Key="Part" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="{Responsive Mobile=16, Tablet=24}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CodeBlock" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CodeBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="ChapterLinks" TargetType="WrapPanel">
            <Setter Property="Margin" Value="-8,8,0,0" />
        </Style>
    </sdk:Page.Resources>

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 15" Style="{StaticResource OverlineText}" />
        <TextBlock Text="Putting it together" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="The OpenSilver Showcase is a real application, with more than 200 samples. Its next version is animated with this library: attributes in its XAML, and two lines of C#. No storyboard, and no code that moves anything." />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Here is a small copy of its window, with the same values. Below it, each of its animations, with its code and the chapters that explain it." />
        <WrapPanel>
            <HyperlinkButton Content="Open the Showcase" NavigateUri="https://opensilvershowcase.com" Style="{StaticResource WebLink}" />
            <HyperlinkButton Content="Its source code on GitHub" NavigateUri="https://github.com/OpenSilver/OpenSilver.Samples.Showcase" Style="{StaticResource WebLink}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,24"
                   Text="Until its next version is published, the site and its code on GitHub use the animation code the Showcase had before, which looks almost the same." />

        <!-- 1. The copy -->
        <controls:DemoCard Title="A small Showcase"
                           Description="Its window, with the names and the values of its XAML. Wait for the menu, or open it with its button on a small screen. Then open the samples: Buttons loads at once, and Data grid takes 2.5 s. On a sample, click View source."
                           Expectations="• The window opens almost empty. The background fades in, the dots and the Welcome title zoom in, and the title bounces a little.&#10;• The line under the title zooms in and makes the title taller. Then the card zooms in below it, and pushes the title up.&#10;• The two tabs at the top right drop in, 0.3 s apart.&#10;• After 4.5 s, the menu slides in from the left, and the welcome page moves aside, a little slower than the menu.&#10;• The logo, the search box, the items of the menu and the tabs are pushed a little by a quick mouse, and spring back.&#10;• Buttons opens at once, without the loading popup. Data grid shows the popup after 1 s: it zooms in, goes a little past its size and comes back. It goes away when the sample is there.&#10;• On a sample, View source slides the pane up from the bottom of the window, at full opacity, and the page shrinks above it. × slides it back down, and the page grows back. Dragging the line between them doesn't animate.&#10;• Phone size (on a phone, the copy is always that size): the window narrows, the menu goes away, and its button fades in at the top left. The button slides the menu in over the page, faster than the first time. Clicking the page or an item of the menu closes it.&#10;• Turn Phone size off: the window widens, and the menu slides in again and pushes the page aside.&#10;• Phone size before the menu has come: the menu never comes by itself, and its button fades in instead.&#10;• Open it again plays everything from the start. With Slow motion, the samples also take four times longer to load.">
            <StackPanel>
                <Border x:Name="ShowcaseHost" />
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Open it again" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" Click="OpenAgain_Click" />
                    <CheckBox x:Name="PhoneSizeSwitch" Content="Phone size" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center"
                              Visibility="{Responsive Mobile=Collapsed, Tablet=Visible}"
                              Checked="PhoneSizeSwitch_Changed" Unchecked="PhoneSizeSwitch_Changed" />
                </WrapPanel>
            </StackPanel>
        </controls:DemoCard>

        <TextBlock Text="How each part is made" Style="{StaticResource HeadingText}" FontSize="20" Margin="0,8,0,12" />

        <!-- 2. The welcome page -->
        <Border Style="{StaticResource Part}">
            <StackPanel>
                <TextBlock Text="The welcome page opens in steps" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                           Text="The background fades in, and the title zooms in from half its size and goes a little past it (Overshoot). The line under the title and the card stay out of the layout until their turn, then push the others (OnPageOpen=PushOthers): the title grows to make room for its line, and moves up to make room for the card." />
                <Border Style="{StaticResource CodeBlock}">
                    <TextBlock Style="{StaticResource CodeText}"
                               Text='&lt;Grid x:Name="BackgroundImagesContainer" anim:Animate.Appear="{anim:Fade StartAfter=1s, Duration=1s, Easing=EaseOut}" /&gt;&#10;&#10;&lt;ContentControl anim:Animate.Appear="{anim:Zoom From=0.5, StartAfter=0.5s, Duration=1s, Easing=Overshoot, Bounciness=1}"&gt;&#10;    &lt;TextBlock Text="Welcome" /&gt;&#10;    &lt;TextBlock Text="TO THE OPENSILVER SHOWCASE!"&#10;               anim:Animate.Appear="{anim:Zoom From=0.5, StartAfter=1.5s, OthersDuration=0.375s, Easing=EaseInOut, OnPageOpen=PushOthers}" /&gt;&#10;&lt;/ContentControl&gt;&#10;&lt;Border anim:Animate.Appear="{anim:Zoom From=0.5, StartAfter=2.7s, Duration=1s, OthersDuration=1.5s, Easing=EaseInOut, OnPageOpen=PushOthers}"&gt;' />
                </Border>
                <WrapPanel Style="{StaticResource ChapterLinks}">
                    <Button Content="Chapter 2: Pick an effect" Tag="2" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                    <Button Content="Chapter 4: Page intros" Tag="4" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 3. The tabs -->
        <Border Style="{StaticResource Part}">
            <StackPanel>
                <TextBlock Text="The tabs drop in" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                           Text="Fork me on GitHub and Suggest new samples slide down, 0.3 s apart. Distance=50% is half their height: they hang from the top of the page, and come from just above it." />
                <Border Style="{StaticResource CodeBlock}">
                    <TextBlock Style="{StaticResource CodeText}"
                               Text='&lt;HyperlinkButton x:Name="ForkOnGitHubButton" Margin="0,-6,20,0"&#10;                 anim:Animate.Appear="{anim:Slide From=Top, Distance=50%, StartAfter=2s, Duration=0.5s, Easing=EaseOut}"&gt;&#10;    &lt;Border anim:Animate.Hover="Nudge"&gt;...&lt;/Border&gt;&#10;&lt;/HyperlinkButton&gt;&#10;&lt;HyperlinkButton x:Name="SuggestSamplesButton" Margin="0,-6,130,0"&#10;                 anim:Animate.Appear="{anim:Slide From=Top, Distance=50%, StartAfter=2.3s, Duration=0.5s, Easing=EaseOut}"&gt;' />
                </Border>
                <WrapPanel Style="{StaticResource ChapterLinks}">
                    <Button Content="Chapter 2: Pick an effect" Tag="2" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 4. The menu -->
        <Border Style="{StaticResource Part}">
            <StackPanel>
                <TextBlock Text="The menu pushes the page aside" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                           Text="The menu waits 4.5 s, until the welcome page has played its intro. Until then it's out of the layout, and the page has the whole width. Then the menu slides in from the left, and the page moves aside in 1.5 s, a little slower than the menu (OthersDuration). The effect is a resource, so that the code can give the menu another one." />
                <Border Style="{StaticResource CodeBlock}">
                    <TextBlock Style="{StaticResource CodeText}"
                               Text='&lt;anim:Slide x:Key="MenuAnimation_OnAppear_Default" From="Left" Distance="50%" StartAfter="4.5s"&#10;            Duration="1s" OthersDuration="1.5s" Easing="EaseOut" OnPageOpen="PushOthers" /&gt;&#10;&#10;&lt;Border x:Name="MenuContainer" anim:Animate.Appear="{StaticResource MenuAnimation_OnAppear_Default}"&gt;' />
                </Border>
                <WrapPanel Style="{StaticResource ChapterLinks}">
                    <Button Content="Chapter 3: When the others move" Tag="3" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                    <Button Content="Chapter 4: Page intros" Tag="4" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 5. Hover -->
        <Border Style="{StaticResource Part}">
            <StackPanel>
                <TextBlock Text="What you can click reacts to the mouse" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                           Text="The logo, the search box, the items of the menu, the theme buttons, the store badges and the tabs have Hover=Nudge: a quick mouse pushes them a little, and they spring back. For the items of the menu, it's in their template, so that every item has it." />
                <Border Style="{StaticResource CodeBlock}">
                    <TextBlock Style="{StaticResource CodeText}"
                               Text='&lt;Grid x:Name="Logo" Cursor="Hand" anim:Animate.Hover="Nudge"&gt;&#10;&lt;local:SearchControl anim:Animate.Hover="Nudge" /&gt;&#10;&#10;&lt;!-- In the template of the items of the menu --&gt;&#10;&lt;Button anim:Animate.Hover="Nudge"&gt;' />
                </Border>
                <WrapPanel Style="{StaticResource ChapterLinks}">
                    <Button Content="Chapter 12: Hover and press" Tag="12" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 6. The source code pane -->
        <Border Style="{StaticResource Part}">
            <StackPanel>
                <TextBlock Text="The source code slides up" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                           Text="View source shows a pane at the bottom of the window. It slides up from below the window at full opacity (Fade=False), as a drawer would, and the page shrinks to make room for it. The code only changes the rows and shows or hides the pane: the library does the rest." />
                <Border Style="{StaticResource CodeBlock}">
                    <TextBlock Style="{StaticResource CodeText}"
                               Text='&lt;Grid x:Name="SourceCodePane" Grid.Row="3" Visibility="Collapsed"&#10;      anim:Animate.Appear="{anim:Slide From=Bottom, Distance=100%, Fade=False, Duration=0.5s, Easing=EaseOut}"&#10;      anim:Animate.Disappear="{anim:Slide To=Bottom, Distance=100%, Fade=False, Duration=0.5s, Easing=EaseIn}"&gt;&#10;&#10;// View source&#10;RowThatContainsTheSourceCodePane.Height = new GridLength(1d, GridUnitType.Star);&#10;SourceCodePane.Visibility = Visibility.Visible;' />
                </Border>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0"
                           Text="In the Showcase, the pane fades out quickly instead of sliding down. The code in it is shown by a WebBrowser, and an element that disappears is a copy of it, which can't show what's inside a WebBrowser." />
                <WrapPanel Style="{StaticResource ChapterLinks}">
                    <Button Content="Chapter 1: Your first animation" Tag="1" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                    <Button Content="Chapter 2: Pick an effect" Tag="2" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 7. Small screens -->
        <Border Style="{StaticResource Part}">
            <StackPanel>
                <TextBlock Text="On a small screen, the menu is a drawer" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                           Text="When the window is narrower than 768 px, the menu hides behind a button, which fades in, and opens over the page. There, the code gives the menu a quicker effect, without OnPageOpen=PushOthers: if the window is small when the Showcase opens, the menu stops waiting for its page, and stays hidden." />
                <Border Style="{StaticResource CodeBlock}">
                    <TextBlock Style="{StaticResource CodeText}"
                               Text='&lt;anim:Slide x:Key="MenuAnimation_OnAppear_Faster" From="Left" Distance="50%"&#10;            Duration="0.5s" OthersDuration="0.75s" Easing="EaseOut" /&gt;&#10;&#10;&lt;Border x:Name="ButtonToHideOrShowMenu" Visibility="Collapsed"&#10;        anim:Animate.Appear="{anim:Fade StartAfter=0.1s, Duration=0.5s, Easing=EaseInOut}"&gt;&#10;&#10;// On small screens&#10;Animate.SetAppear(MenuContainer, (Transition)this.Resources["MenuAnimation_OnAppear_Faster"]);' />
                </Border>
                <WrapPanel Style="{StaticResource ChapterLinks}">
                    <Button Content="Chapter 13: From code" Tag="13" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 8. The loading popup -->
        <Border Style="{StaticResource Part}">
            <StackPanel>
                <TextBlock Text="The loading popup only shows when it's needed" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                           Text="Some samples take a moment to load. The popup that says so zooms in with a little overshoot, but only after 1 s: when a sample loads sooner, the popup is hidden again before its turn, and nothing flashes. Its effect is made in C#, like any object." />
                <Border Style="{StaticResource CodeBlock}">
                    <TextBlock Style="{StaticResource CodeText}"
                               Text='ShowLoadingPopup(itemsControl, new Zoom { From = 0.5, Easing = Easings.Overshoot, Bounciness = 0.3,&#10;                                          StartAfter = AnimationTime.FromSeconds(1) });' />
                </Border>
                <WrapPanel Style="{StaticResource ChapterLinks}">
                    <Button Content="Chapter 4: Page intros" Tag="4" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                    <Button Content="Chapter 13: From code" Tag="13" Style="{StaticResource LinkButton}" Click="Chapter_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The intro of the Showcase is long on purpose: it's the first thing its visitors see. In a page that people open every day, keep the whole intro under a second, as chapter 4 says." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• To see how it's put together, slow it down. The Showcase keeps two lines for that in its MainPage, commented out: AnimationSettings.Current.Speed = 0.1 makes everything ten times slower, and AnimationSettings.Current.LogForDebugging = true writes what animates, and why, in the browser console." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The copy above is simpler than the Showcase: its samples are pretend, and it has no themes, store badges or search." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="15" />
    </StackPanel>
</sdk:Page>
