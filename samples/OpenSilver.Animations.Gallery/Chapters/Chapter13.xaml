<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.Chapter13"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="What never animates, and why">

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 13" Style="{StaticResource OverlineText}" />
        <TextBlock Text="What never animates, and why" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Some changes must follow your hand, or the page would feel slow: scrolling, dragging, typing and resizing the window. They never animate, even inside an area with ApplyTo=EverythingInside, and you have nothing to do for that." />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Each demo below has a button that makes the same kind of change from code, which does animate." />

        <!-- 1. Scrolling -->
        <controls:DemoCard Title="Scrolling"
                           Description="This list is inside an area with ApplyTo=EverythingInside. Scroll it: the rows move with the scroll bar, at once. Then make the rows taller."
                           Xaml='&lt;ScrollViewer Height="220" anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}"&gt;'
                           Expectations="• Scrolling, with the wheel or the scroll bar, follows your hand exactly.&#10;• Make the rows taller: the rows grow smoothly, and the scroll bar adjusts.">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="0" Width="{Responsive Mobile=NaN, Tablet=420}" HorizontalAlignment="{Responsive Mobile=Stretch, Tablet=Left}" ClipToBounds="True">
                    <ScrollViewer Height="220" BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}">
                        <StackPanel x:Name="ScrollRows" />
                    </ScrollViewer>
                </Border>
                <Button x:Name="RowsButton" Content="Make the rows taller" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Rows_Click" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 2. GridSplitter -->
        <controls:DemoCard Title="Dragging a splitter"
                           Description="The two panes are in a Grid with ApplyTo=EverythingInside. Drag the handle between them: the panes follow the pointer exactly. Reset the split: they glide back."
                           Xaml='&lt;Grid anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}"&gt;&#10;    &lt;sdk:GridSplitter Grid.Column="1" /&gt;'
                           Expectations="• While you drag, nothing lags behind the pointer.&#10;• Reset the split: both panes glide to their original widths.">
            <StackPanel>
                <Grid Height="150" anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="220" MinWidth="80" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Folders" FontWeight="SemiBold" />
                            <TextBlock Text="Inbox" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                            <TextBlock Text="Drafts" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Sent" Style="{StaticResource BodyText}" />
                        </StackPanel>
                    </Border>
                    <sdk:GridSplitter Grid.Column="1" Width="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False" />
                    <Border Grid.Column="1" Width="4" Height="40" CornerRadius="2" Background="#C9CCD8" IsHitTestVisible="False" />
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Messages" FontWeight="SemiBold" />
                            <TextBlock Text="The pane on the left keeps the width you give it. This one takes the rest." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Button Content="Reset the split" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ResetSplit_Click" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 3. Slider -->
        <controls:DemoCard Title="Dragging a slider"
                           Description="The width of the bar follows the slider, and the bar has MoveAndResize=Smooth. Drag the thumb, then click on the track on either side of it."
                           Xaml='&lt;Border x:Name="Bar" Width="{Binding Value, ElementName=BarSlider}" anim:Animate.MoveAndResize="Smooth" /&gt;'
                           Expectations="• Drag the thumb: the bar follows it exactly.&#10;• Click on the track: the value jumps, and the bar glides to its new width. The thumb glides with it, because it moved in the same change.">
            <StackPanel>
                <Slider x:Name="BarSlider" Width="{Responsive Mobile=240, Tablet=420}" HorizontalAlignment="Left" Minimum="40" Maximum="{Responsive Mobile=240, Tablet=420}" Value="160" SmallChange="10" LargeChange="80"
                        ValueChanged="BarSlider_ValueChanged" />
                <Border x:Name="SliderBar" Width="160" Height="28" CornerRadius="8" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0,12,0,0"
                        anim:Animate.MoveAndResize="Smooth" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 4. Typing -->
        <controls:DemoCard Title="Typing"
                           Description="This text box grows with its text, and has MoveAndResize=Smooth. Type in it: it grows at once, and the Send button stays right next to it. Then add a word from code."
                           Xaml='&lt;TextBox MinWidth="120" MaxWidth="440" anim:Animate.MoveAndResize="Smooth" /&gt;'
                           Expectations="• While you type, the text box and the Send button follow every letter at once.&#10;• Add a word from code: the text box grows smoothly, and the Send button slides.">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="AutoWidthBox" Text="Type here" MinWidth="120" MaxWidth="{Responsive Mobile=160, Tablet=440}" VerticalAlignment="Center"
                             anim:Animate.MoveAndResize="Smooth" />
                    <Button Content="Send" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
                <Button Content="Add a word from code" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="AddWord_Click" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 5. Window resize -->
        <controls:DemoCard Title="Resizing the browser window"
                           Description="Make your browser window narrower: the whole tour reflows at once, although several of its elements have MoveAndResize. Elements can opt in with AlsoOnWindowResize=True.">
            <Button Content="See chapter 8: Following the browser window" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="Chapter8_Click" />
        </controls:DemoCard>

        <!-- 6. Budget -->
        <controls:DemoCard Title="Too many elements at once"
                           Description="When more than 300 elements would animate together, the whole change happens at once instead, because animating that many would be slow. Elements outside the window don't count."
                           Xaml='&lt;WrapPanel anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}"&gt;&#10;    &lt;!-- 100 or 400 tiles --&gt;&#10;&lt;/WrapPanel&gt;'
                           Expectations="• With 100 tiles, they all grow smoothly.&#10;• With 400 tiles, they all grow at once, and the What just happened log says why.">
            <StackPanel>
                <WrapPanel x:Name="BudgetTiles" anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="TileCountButton" Content="Use 400 tiles" Style="{StaticResource SecondaryButton}" Click="TileCount_Click" />
                    <Button Content="Grow the tiles" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="GrowTiles_Click" />
                </StackPanel>
            </StackPanel>
        </controls:DemoCard>

        <!-- 7. Limits -->
        <TextBlock Text="Two limits to know" Style="{StaticResource HeadingText}" FontSize="22" Margin="0,16,0,6" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="These are not choices: the browser decides how text and some shapes are drawn while their box animates." />

        <controls:DemoCard Title="Text that wraps"
                           Description="This box has MoveAndResize=Smooth and changes width. The box glides, but the text inside it is laid out again by the browser at every step, so words hop from one line to the next while it resizes."
                           Xaml='&lt;Border Width="520" anim:Animate.MoveAndResize="Smooth"&gt;&#10;    &lt;TextBlock TextWrapping="Wrap" /&gt;&#10;&lt;/Border&gt;'
                           Expectations="• The box resizes smoothly.&#10;• The words move to their new lines during the animation; the text is always readable when it ends.&#10;• Tip: animate the width of text only when it doesn't wrap, or when the change is small.">
            <StackPanel>
                <Border x:Name="WrapBox" Width="{Responsive Mobile=260, Tablet=520}" Style="{StaticResource Card}" HorizontalAlignment="Left" anim:Animate.MoveAndResize="Smooth">
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="OpenSilver runs your C# and XAML in the browser, with no plugin. The same code runs on the web, on the desktop and on mobile, and the layout of this paragraph is recomputed each time its box changes width." />
                </Border>
                <Button Content="Change the width" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="WrapBox_Click" />
            </StackPanel>
        </controls:DemoCard>

        <controls:DemoCard Title="Shapes drawn with Path"
                           Description="Each box has MoveAndResize=Smooth and holds a shape that fills it. The Rectangle and the Ellipse are redrawn at every step. A Path is drawn once, at its final size."
                           Xaml='&lt;Rectangle Fill="..." /&gt;     &lt;!-- follows the box --&gt;&#10;&lt;Ellipse Fill="..." /&gt;       &lt;!-- follows the box --&gt;&#10;&lt;Path Stretch="Fill" Data="..." /&gt;   &lt;!-- jumps to its final size --&gt;'
                           Expectations="• The rectangle and the circle grow and shrink smoothly with their boxes.&#10;• The star jumps to its final size at once, while its box glides.">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Height="{Responsive Mobile=90, Tablet=160}">
                    <Border x:Name="RectangleBox" Width="{Responsive Mobile=50, Tablet=80}" Height="{Responsive Mobile=50, Tablet=80}" VerticalAlignment="Top" anim:Animate.MoveAndResize="Smooth">
                        <Rectangle Fill="{StaticResource AccentBrush}" RadiusX="10" RadiusY="10" />
                    </Border>
                    <Border x:Name="EllipseBox" Width="{Responsive Mobile=50, Tablet=80}" Height="{Responsive Mobile=50, Tablet=80}" VerticalAlignment="Top"
                            Margin="{Responsive Mobile='12,0,0,0', Tablet='24,0,0,0'}" anim:Animate.MoveAndResize="Smooth">
                        <Ellipse Fill="#E07A1F" />
                    </Border>
                    <Border x:Name="PathBox" Width="{Responsive Mobile=50, Tablet=80}" Height="{Responsive Mobile=50, Tablet=80}" VerticalAlignment="Top"
                            Margin="{Responsive Mobile='12,0,0,0', Tablet='24,0,0,0'}" BorderBrush="#D9DCE7" BorderThickness="1" CornerRadius="6"
                            anim:Animate.MoveAndResize="Smooth">
                        <Path Fill="#239B6A" Stretch="Fill" Margin="6"
                              Data="M 50,0 L 61,35 L 98,35 L 68,57 L 79,91 L 50,70 L 21,91 L 32,57 L 2,35 L 39,35 Z" />
                    </Border>
                </StackPanel>
                <Button Content="Resize the shapes" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Shapes_Click" />
            </StackPanel>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Also instant" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Every change, when the device asks for reduced motion, when AnimationSettings.IsEnabled is false, inside Animate.Skip, and in the Visual Studio designer." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• The changes that start inside an element with MoveAndResize=None." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Elements that appear, outside an area with ApplyTo=EverythingInside: they are in their place at once, and only the others move. Inside such an area they are revealed, as in the settings form of chapter 7. Effects of your own for appearing and disappearing come with the next version." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="13" />
    </StackPanel>
</sdk:Page>
