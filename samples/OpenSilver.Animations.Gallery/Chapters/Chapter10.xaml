<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.Chapter10"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="Bouncy and Wave">

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 10" Style="{StaticResource OverlineText}" />
        <TextBlock Text="Bouncy and Wave" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Smooth is right most of the time. Two variations add character: Bouncy overshoots a little and settles, like a spring, and Wave makes the elements farther from the change start a bit later." />

        <!-- 1. Bouncy tab underline -->
        <controls:DemoCard Title="A tab underline that bounces"
                           Description="Click the tabs. The underline is in the Grid column of the selected tab: changing its Grid.Column moves it and changes its width, and Bouncy makes it overshoot a little before it settles."
                           Xaml='&lt;Border x:Name="Underline" Grid.Row="1" Height="3" anim:Animate.MoveAndResize="Bouncy" /&gt;&#10;&#10;&lt;!-- With parameters --&gt;&#10;anim:Animate.MoveAndResize="{anim:Bouncy Bounciness=0.5, Duration=0.5s}"'
                           Expectations="• The underline slides to the tab you click, overshoots a little, and settles.&#10;• Its width changes smoothly, without bouncing, so it never wobbles.&#10;• With more bounciness, it overshoots more.">
            <StackPanel>
                <Grid x:Name="Tabs" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Content="Overview" Style="{StaticResource TabButton}" Tag="0" Click="Tab_Click" />
                    <Button Grid.Column="1" Content="Activity" Style="{StaticResource TabButton}" Tag="1" Click="Tab_Click" />
                    <Button Grid.Column="2" Content="Team" Style="{StaticResource TabButton}" Tag="2" Click="Tab_Click" />
                    <Button Grid.Column="3" Content="Settings" Style="{StaticResource TabButton}" Tag="3" Click="Tab_Click" />
                    <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="{StaticResource LineBrush}" VerticalAlignment="Bottom" />
                    <Border x:Name="Underline" Grid.Row="1" Height="3" CornerRadius="1.5" Margin="{Responsive Mobile='6,0', Tablet='10,0'}" Background="{StaticResource AccentBrush}"
                            anim:Animate.MoveAndResize="Bouncy" />
                </Grid>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="340" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bounciness" Style="{StaticResource SliderLabel}" />
                    <Slider x:Name="BouncinessSlider" Grid.Column="1" Minimum="0.1" Maximum="1" Value="0.5" SmallChange="0.1" LargeChange="0.1"
                            ValueChanged="BouncySettings_Changed" />
                    <TextBlock x:Name="BouncinessText" Grid.Column="2" Text="0.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="1" Text="Duration" Style="{StaticResource SliderLabel}" Margin="0,8,0,0" />
                    <Slider x:Name="BouncyDurationSlider" Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="1.5" Value="0.5" SmallChange="0.1" LargeChange="0.1" Margin="0,8,0,0"
                            ValueChanged="BouncySettings_Changed" />
                    <TextBlock x:Name="BouncyDurationText" Grid.Row="1" Grid.Column="2" Text="0.5 s" VerticalAlignment="Center" Margin="12,8,0,0" />
                </Grid>
            </StackPanel>
        </controls:DemoCard>

        <!-- 2. Wave -->
        <controls:DemoCard Title="Cards that move like a wave"
                           Description="The cards are in a StackPanel that has ApplyTo=EverythingInside and a Wave. When the first card grows, the cards below it start moving one after the other, the farthest last."
                           Xaml='&lt;StackPanel anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside, Wave=0.8, Duration=0.4s}"&gt;'
                           Expectations="• The first card grows, and the cards below follow it one after the other, like a wave.&#10;• With Wave at 0, they all move at the same time.&#10;• The content of the first card never lags behind the card.">
            <StackPanel>
                <StackPanel x:Name="WaveArea" MaxWidth="520" HorizontalAlignment="Left"
                            anim:Animate.MoveAndResize="{anim:Smooth ApplyTo=EverythingInside, Wave=0.8, Duration=0.4s}">
                    <Border x:Name="GrowingCard" Style="{StaticResource Card}" Height="64" Padding="16,12" Margin="0,0,0,8" ClipToBounds="True">
                        <StackPanel>
                            <TextBlock Text="Release notes" FontWeight="SemiBold" />
                            <TextBlock Text="Version 3.4 brings faster layout and the new animations library." Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                            <TextBlock Text="It also improves the way text is measured, so that pages appear sooner, and it fixes forty bugs reported by the community. Thank you for them!" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Invoices" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Team calendar" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Design reviews" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Support tickets" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0" Margin="0,0,0,8">
                        <TextBlock Text="Archived projects" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource Card}" Height="52" Padding="16,0">
                        <TextBlock Text="Trash" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="GrowButton" Content="Show the release notes" Style="{StaticResource SecondaryButton}" Click="Grow_Click" />
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="340" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wave" Style="{StaticResource SliderLabel}" />
                    <Slider x:Name="WaveSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.8" SmallChange="0.1" LargeChange="0.1"
                            ValueChanged="WaveSlider_ValueChanged" />
                    <TextBlock x:Name="WaveText" Grid.Column="2" Text="0.8" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </StackPanel>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Bouncy lasts twice as long as Smooth by default (0.5 s), so that the bounce has time to settle." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• With Wave, an element starts at most 0.2 s after the change, when it is 600 pixels away or more. What is inside an element always moves with it." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Both can make elements overlap for a moment: a bounce goes past the end, and a wave lets the first elements reach the place of the next ones. Use them for small, playful moves." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="10" />
    </StackPanel>
</sdk:Page>
