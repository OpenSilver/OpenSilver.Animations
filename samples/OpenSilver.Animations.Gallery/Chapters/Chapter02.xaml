<sdk:Page x:Class="OpenSilver.Animations.Gallery.Chapters.Chapter02"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
          xmlns:anim="http://opensilver.net/animations"
          xmlns:controls="clr-namespace:OpenSilver.Animations.Gallery.Controls"
          Title="Pick an effect">

    <sdk:Page.Resources>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- An easing choice: a square tile with the curve of the easing named by its Content -->
        <Style x:Key="CurveChoice" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="72" Height="72">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverTile" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedTile" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" />
                            <Border x:Name="HoverTile" BorderBrush="#C9CCD8" BorderThickness="1" CornerRadius="10" Opacity="0" />
                            <Border x:Name="SelectedTile" Background="{StaticResource AccentLightBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                    CornerRadius="10" Opacity="0" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:EasingCurve EasingName="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </sdk:Page.Resources>

    <StackPanel Style="{StaticResource ChapterRoot}">
        <TextBlock Text="CHAPTER 2" Style="{StaticResource OverlineText}" />
        <TextBlock Text="Pick an effect" Style="{StaticResource ChapterTitleText}" />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Fade is one of seven effects. Write the name of an effect for its defaults, like Appear=&quot;Slide&quot;, or use it as a markup extension to change its parameters, like Appear=&quot;{anim:Slide From=Top, Duration=0.5s}&quot;." />
        <TextBlock Style="{StaticResource IntroText}"
                   Text="Whatever the effect, the elements around the element make room for it or fill its space with the same duration, so that nothing overlaps." />

        <!-- 1. Every effect -->
        <controls:DemoCard x:Name="EffectDemo" Title="Every effect"
                           Description="Choose an effect and its parameters, then hide and show the card. The text below the card makes room for it and fills its space with the duration of the effect."
                           Expectations="• Each effect plays when the card is shown, and again, the other way around, when it is hidden.&#10;• Slide and Wipe follow the side you choose: the card comes from it, and goes back to it.&#10;• Slide follows the distance you choose: at 100%, the card starts a whole card height away (a whole width from the left or the right).&#10;• Zoom follows the size you choose: the card starts from that size, and goes back to it. At 120%, it shrinks into place.&#10;• With Fade set to No, Slide and Zoom don't fade: the card is fully visible while it moves or grows.&#10;• With Bouncy, or with Pop, the card bounces, but it fades in without bouncing, and the text below moves smoothly.&#10;• With Overshoot, the card goes a little past its place or its size, and comes back, once. The text below moves with EaseOut, without overshooting.&#10;• With EaseIn, the card starts slowly and leaves fast. With EaseOut, it starts fast and ends slowly.&#10;• Each easing shows its curve, on the same scale: Linear is a straight line, EaseIn starts flat, EaseOut ends flat, and Bouncy and Overshoot go above the top dotted line before they come back to it.&#10;• With Text below set to 1 s, the text takes 1 second to make room or to fill the space, whatever the duration of the card.&#10;• Hide and show the card quickly: it never jumps.">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Effect" Style="{StaticResource SliderLabel}" />
                    <WrapPanel x:Name="EffectChoices" Grid.Column="1">
                        <RadioButton Content="Fade" GroupName="Effect" Style="{StaticResource Choice}" IsChecked="True" Checked="Option_Checked" />
                        <RadioButton Content="Slide" GroupName="Effect" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="Zoom" GroupName="Effect" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="Pop" GroupName="Effect" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="Wipe" GroupName="Effect" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="Blur" GroupName="Effect" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="Custom" GroupName="Effect" Style="{StaticResource Choice}" Checked="Option_Checked" />
                    </WrapPanel>

                    <!-- Only for Slide and Wipe: the rows below make room when they appear -->
                    <TextBlock x:Name="SideLabel" Grid.Row="1" Text="Side" Style="{StaticResource SliderLabel}" Visibility="Collapsed"
                               anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade" />
                    <WrapPanel x:Name="SideChoices" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"
                               anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                        <RadioButton Content="Bottom" GroupName="Side" Style="{StaticResource Choice}" IsChecked="True" Checked="Option_Checked" />
                        <RadioButton Content="Top" GroupName="Side" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="Left" GroupName="Side" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="Right" GroupName="Side" Style="{StaticResource Choice}" Checked="Option_Checked" />
                    </WrapPanel>

                    <!-- Only for Slide -->
                    <TextBlock x:Name="DistanceLabel" Grid.Row="2" Text="Distance" Style="{StaticResource SliderLabel}" Visibility="Collapsed"
                               anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade" />
                    <WrapPanel x:Name="DistanceChoices" Grid.Row="2" Grid.Column="1" Visibility="Collapsed"
                               anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                        <RadioButton Content="Medium" Tag="Medium" GroupName="Distance" Style="{StaticResource Choice}" IsChecked="True" Checked="Option_Checked" />
                        <RadioButton Content="Long" Tag="Long" GroupName="Distance" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="50%" Tag="50%" GroupName="Distance" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="100%" Tag="100%" GroupName="Distance" Style="{StaticResource Choice}" Checked="Option_Checked" />
                    </WrapPanel>

                    <!-- Only for Zoom -->
                    <TextBlock x:Name="SizeLabel" Grid.Row="3" Text="Size" Style="{StaticResource SliderLabel}" Visibility="Collapsed"
                               anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade" />
                    <WrapPanel x:Name="SizeChoices" Grid.Row="3" Grid.Column="1" Visibility="Collapsed"
                               anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                        <RadioButton Content="90%" Tag="0.9" GroupName="Size" Style="{StaticResource Choice}" IsChecked="True" Checked="Option_Checked" />
                        <RadioButton Content="50%" Tag="0.5" GroupName="Size" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="120%" Tag="1.2" GroupName="Size" Style="{StaticResource Choice}" Checked="Option_Checked" />
                    </WrapPanel>

                    <!-- Only for Slide and Zoom -->
                    <TextBlock x:Name="FadeLabel" Grid.Row="4" Text="Fade" Style="{StaticResource SliderLabel}" Visibility="Collapsed"
                               anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade" />
                    <WrapPanel x:Name="FadeChoices" Grid.Row="4" Grid.Column="1" Visibility="Collapsed"
                               anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                        <RadioButton Content="Yes" Tag="True" GroupName="Fade" Style="{StaticResource Choice}" IsChecked="True" Checked="Option_Checked" />
                        <RadioButton Content="No" Tag="False" GroupName="Fade" Style="{StaticResource Choice}" Checked="Option_Checked" />
                    </WrapPanel>

                    <TextBlock Grid.Row="5" Text="Duration" Style="{StaticResource SliderLabel}" />
                    <WrapPanel x:Name="DurationChoices" Grid.Row="5" Grid.Column="1">
                        <RadioButton Content="Default" Tag="" GroupName="Duration" Style="{StaticResource Choice}" IsChecked="True" Checked="Option_Checked" />
                        <RadioButton Content="0.5 s" Tag="0.5s" GroupName="Duration" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="1 s" Tag="1s" GroupName="Duration" Style="{StaticResource Choice}" Checked="Option_Checked" />
                    </WrapPanel>

                    <TextBlock Grid.Row="6" Text="Text below" Style="{StaticResource SliderLabel}" />
                    <WrapPanel x:Name="OthersDurationChoices" Grid.Row="6" Grid.Column="1">
                        <RadioButton Content="With the card" Tag="" GroupName="OthersDuration" Style="{StaticResource Choice}" IsChecked="True" Checked="Option_Checked" />
                        <RadioButton Content="0.5 s" Tag="0.5s" GroupName="OthersDuration" Style="{StaticResource Choice}" Checked="Option_Checked" />
                        <RadioButton Content="1 s" Tag="1s" GroupName="OthersDuration" Style="{StaticResource Choice}" Checked="Option_Checked" />
                    </WrapPanel>

                    <!-- Pop always bounces. The label is beside the first row of tiles. -->
                    <TextBlock x:Name="EasingLabel" Grid.Row="7" Text="Easing" Style="{StaticResource SliderLabel}" VerticalAlignment="Top" Margin="0,30,0,0" />
                    <StackPanel Grid.Row="7" Grid.Column="1">
                        <WrapPanel x:Name="EasingChoices">
                            <RadioButton Content="Smooth" GroupName="Easing" Style="{StaticResource CurveChoice}" IsChecked="True" Checked="Option_Checked" />
                            <RadioButton Content="Gentle" GroupName="Easing" Style="{StaticResource CurveChoice}" Checked="Option_Checked" />
                            <RadioButton Content="Linear" GroupName="Easing" Style="{StaticResource CurveChoice}" Checked="Option_Checked" />
                            <RadioButton Content="Bouncy" GroupName="Easing" Style="{StaticResource CurveChoice}" Checked="Option_Checked" />
                            <RadioButton Content="EaseOut" GroupName="Easing" Style="{StaticResource CurveChoice}" Checked="Option_Checked" />
                            <RadioButton Content="EaseIn" GroupName="Easing" Style="{StaticResource CurveChoice}" Checked="Option_Checked" />
                            <RadioButton Content="EaseInOut" GroupName="Easing" Style="{StaticResource CurveChoice}" Checked="Option_Checked" />
                            <RadioButton Content="Overshoot" GroupName="Easing" Style="{StaticResource CurveChoice}" Checked="Option_Checked" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   Text="Each drawing shows how the card moves: the time goes from left to right, and the card goes from where it starts, the bottom dotted line, to where it ends, the top one." />
                    </StackPanel>
                </Grid>

                <StackPanel MaxWidth="360" HorizontalAlignment="Left" Margin="0,20,0,0">
                    <Border x:Name="SampleCard" Height="{Responsive Mobile=100, Tablet=120}" CornerRadius="12" Padding="18"
                            anim:Animate.Appear="Fade" anim:Animate.Disappear="Fade">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6D6DE8" Offset="0" />
                                <GradientStop Color="#B45BD6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Weekend in Lisbon" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="3 nights · from $420" Foreground="#E6E3FA" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="This text has no setting. It makes room for the card, and fills its space when it is hidden." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
                <Button x:Name="SampleButton" Content="Hide the card" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SampleButton_Click" />
            </StackPanel>
        </controls:DemoCard>

        <!-- 2. Validation message -->
        <controls:DemoCard Title="A message under a field"
                           Description="Click Sign up with the address as it is. A message slides in under the field, and the button makes room for it. Then complete the address: the message fades out as soon as it is right, and the button slides back up."
                           Xaml='&lt;TextBlock x:Name="EmailError" Visibility="Collapsed"&#10;           anim:Animate.Appear="{anim:Slide From=Top, Distance=Short}"&#10;           anim:Animate.Disappear="Fade" /&gt;'
                           Expectations="• The message slides down a little while it fades in, and the Sign up button slides down with it.&#10;• Type the end of the address, like .com: the message fades out, and the button slides back up.">
            <StackPanel MaxWidth="360" HorizontalAlignment="Left">
                <TextBlock Text="Email" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="EmailBox" Text="alex@example" Margin="0,4,0,0" TextChanged="EmailBox_TextChanged" />
                <TextBlock x:Name="EmailError" Text="Add the end of the address, like alex@example.com." Foreground="#C62828" FontSize="13" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="Collapsed"
                           anim:Animate.Appear="{anim:Slide From=Top, Distance=Short}" anim:Animate.Disappear="Fade" />
                <Button Content="Sign up" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SignUp_Click" />
            </StackPanel>
        </controls:DemoCard>

        <Border Style="{StaticResource TipBox}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• From is the side an element comes from when it appears, and To the side it goes to when it disappears. Both are Bottom by default." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• On Zoom, From is the size it grows from, and To the size it shrinks to: 0.9 (90%) by default, 0.5 for half its size, or more than 1 to come from bigger." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Distance is how far Slide moves: Short (10 pixels), Medium (30 pixels, the default), Long (100 pixels), a number of pixels, or a percent of the element's size, like 50%: of its height from the top or the bottom, of its width from the left or the right." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Fade=False makes Slide and Zoom move or grow without fading. With Distance=100%, a panel comes in from beyond its edge, like a drawer: {anim:Slide From=Bottom, Distance=100%, Fade=False}." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Pop is for appearing. To make an element disappear in a similar way, use Zoom. Pop, and every effect with Easing=Bouncy, lasts twice as long by default, so that the bounce has time to settle." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Easing also has the classic curves: EaseOut, EaseIn and EaseInOut, like a CubicEase, and Overshoot, like a BackEase. Bounciness says how far Overshoot goes past the end: 0.5 by default, 1 for a lot." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• OthersDuration is how long the elements around take to make room or to fill the space. By default, they take the Duration of the effect." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• Custom describes the look the element starts from, or ends with: {anim:Custom Opacity=0, OffsetY=20, Zoom=0.8, Rotate=-6}." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="• A parameter that doesn't apply, like To on an Appear, is ignored, with a message in the log." />
            </StackPanel>
        </Border>

        <controls:ChapterNavigation Chapter="2" />
    </StackPanel>
</sdk:Page>
