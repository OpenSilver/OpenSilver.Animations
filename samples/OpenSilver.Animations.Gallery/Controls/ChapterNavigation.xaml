<UserControl x:Class="OpenSilver.Animations.Gallery.Controls.ChapterNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,16,0,0">
        <Button x:Name="PreviousButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="PreviousButton_Click">
            <StackPanel>
                <TextBlock Text="PREVIOUS" FontSize="11" FontWeight="Bold" CharacterSpacing="60" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="PreviousTitle" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>
        </Button>
        <Button x:Name="NextButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Click="NextButton_Click">
            <StackPanel>
                <TextBlock Text="NEXT" FontSize="11" FontWeight="Bold" CharacterSpacing="60" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                <TextBlock x:Name="NextTitle" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" HorizontalAlignment="Right" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
