<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <RootNamespace>OpenSilver.Animations.Gallery</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="[$(OpenSilverVersion)]" />
    <PackageReference Include="OpenSilver.Themes.Modern" Version="3.4.0-preview-2026-07-20-092918-c8997484" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenSilver.Animations\OpenSilver.Animations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Page Include="**\*.xaml" Exclude="App.xaml;bin\**;obj\**">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <Content Include="Images\**" />
  </ItemGroup>

</Project>
