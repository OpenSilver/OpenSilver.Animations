<Project>

  <PropertyGroup>
    <!--
      The library needs OpenSilver's InternalHooks, which are internal and visible to this library
      through InternalsVisibleTo. Until an OpenSilver build that includes them
      is published, build it locally with build\Build_Local_OpenSilver.bat (it fills build\local-packages).
    -->
    <OpenSilverVersion Condition=" '$(OpenSilverVersion)' == '' ">3.4.0-preview-animations-local</OpenSilverVersion>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

</Project>
